@model IEnumerable<MarketLink.Models.Notification>
@{
    ViewData["Title"] = "Notifications";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 style="margin:0;font-weight:700;color:var(--heading);"><i class="fas fa-bell me-2" style="color:var(--accent-text)"></i>Notifications</h4>
        <p style="margin:4px 0 0;font-size:13px;color:var(--muted);">Order requests, status changes and farm updates for your account.</p>
    </div>
    <a asp-action="Index" class="btn btn-sm" style="border:1px solid var(--border);color:var(--heading);border-radius:var(--radius-sm);">
        <i class="fas fa-home me-1"></i>Dashboard
    </a>
</div>

@if (!Model.Any())
{
    <div class="card" style="border:1px dashed var(--border);border-radius:var(--radius);background:var(--card);">
        <div class="card-body text-center py-5">
            <div style="font-size:44px;margin-bottom:12px;">🔔</div>
            <h5 style="color:var(--heading);font-weight:700;margin:0;">No notifications yet</h5>
            <p class="text-muted small mb-0 mt-2">You'll be alerted here whenever a customer places an order.</p>
        </div>
    </div>
}
else
{
    <div class="card" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);box-shadow:var(--shadow-sm);overflow:hidden;">
        <div class="list-group list-group-flush">
            @foreach (var n in Model)
            {
                <div class="list-group-item p-3 d-flex align-items-start gap-3" style="border-color:var(--border);background:@(n.IsRead ? "var(--card)" : "rgba(92,111,43,0.06)")">
                    <div style="width:38px;height:38px;border-radius:50%;background:rgba(92,111,43,0.12);display:flex;align-items:center;justify-content:center;color:var(--primary-text);flex-shrink:0;">
                        <i class="fas fa-bell"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <h6 class="mb-0" style="font-weight:700;color:@(n.IsRead ? "var(--muted)" : "var(--heading)");">@n.Title</h6>
                            <small class="text-muted">@n.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</small>
                        </div>
                        <p class="mb-2 small" style="color:var(--muted);">@n.Message</p>
                        <div class="d-flex align-items-center gap-3">
                            @if (!string.IsNullOrEmpty(n.Link))
                            {
                                <a href="@n.Link" class="btn btn-sm" style="background:var(--primary);color:#fff;border-radius:var(--radius-sm);padding:2px 10px;font-size:12px;">View details</a>
                            }
                            @if (!n.IsRead)
                            {
                                <form asp-action="MarkNotificationRead" asp-route-id="@n.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm p-0" style="background:transparent;border:none;color:var(--muted);font-size:12px;cursor:pointer;">
                                        <i class="fas fa-check me-1"></i>Mark as read
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
