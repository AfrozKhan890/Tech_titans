@inject MarketLink.Repositories.IUnitOfWork MlUnitOfWork
@{
    var mlUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var mlUnread = string.IsNullOrEmpty(mlUserId)
        ? 0
        : await MlUnitOfWork.Repository<Notification>().CountAsync(n => n.UserId == mlUserId && !n.IsRead);
    var mlFarmerId = await MarketLink.Services.ActorResolver.ResolveFarmerIdAsync(User, MlUnitOfWork, Context);
    var mlFarm = mlFarmerId == null ? null : await MlUnitOfWork.Repository<MarketLink.Models.Farmer>().GetByIdAsync(mlFarmerId.Value);
}
<!DOCTYPE html>
<html lang="en" data-theme="light" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Farmer Dashboard | MarketLink</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body data-authenticated="true" data-notifications-url="/Farmer/Dashboard/UnreadCountJson">
<div class="dashboard-overlay" id="sidebar-overlay"></div>

<aside class="dashboard-sidebar" id="farmer-sidebar">
    @{
        var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAct = ViewContext.RouteData.Values["action"]?.ToString();
        var orderStatus = ViewContext.HttpContext.Request.Query["status"].ToString();
        var farmApproved = mlFarm?.Status == MarketLink.Models.Enums.FarmerStatus.Approved;
    }
    <div class="sidebar-brand-fixed" id="sidebar-brand-header">
        <div class="d-flex align-items-center justify-content-between">
            <a asp-area="Farmer" asp-controller="Dashboard" asp-action="Index" class="brand-link">
                <div class="brand-icon-box">
                    <i class="fas fa-tractor"></i>
                </div>
                <div class="brand-text-box">
                    <h4 class="brand-title">Farmer<span> Hub</span></h4>
                    <p class="brand-user">
                        <i class="fas fa-circle @(farmApproved ? "text-success" : "text-warning") me-1" style="font-size:7px;"></i>@(mlFarm?.FarmName ?? "Your farm") · @(mlFarm?.Status.ToString() ?? "Unknown")
                    </p>
                </div>
            </a>
            <button type="button" class="btn btn-sm btn-light d-lg-none rounded-circle" id="sidebar-close-btn" style="width:32px;height:32px;padding:0;display:inline-flex;align-items:center;justify-content:center;" aria-label="Close Sidebar">
                <i class="fas fa-times text-muted"></i>
            </button>
        </div>
    </div>

    <nav class="sidebar-nav">
        <ul class="sidebar-menu-list">
            <li class="sidebar-section-header">
                <span class="sidebar-section-label">Overview</span>
            </li>
            <li class="sidebar-menu-item">
                <a class="sidebar-nav-item @(currentCtrl == "Dashboard" && currentAct == "Index" ? "active" : "")" asp-area="Farmer" asp-controller="Dashboard" asp-action="Index" title="Dashboard">
                    <span class="nav-icon"><i class="fas fa-home"></i></span>
                    <span class="sidebar-nav-text">Dashboard</span>
                </a>
            </li>

            <li class="sidebar-section-header">
                <span class="sidebar-section-label">Farm</span>
            </li>
            <li class="sidebar-menu-item">
                <a class="sidebar-nav-item @(currentCtrl == "Profile" && currentAct == "Index" ? "active" : "")" asp-area="Farmer" asp-controller="Profile" asp-action="Index" title="My Profile">
                    <span class="nav-icon"><i class="fas fa-user-circle"></i></span>
                    <span class="sidebar-nav-text">My Profile</span>
                </a>
            </li>
            <li class="sidebar-menu-item">
                <a class="sidebar-nav-item @(currentCtrl == "Profile" && currentAct == "Markets" ? "active" : "")" asp-area="Farmer" asp-controller="Profile" asp-action="Markets" title="My Markets">
                    <span class="nav-icon"><i class="fas fa-store"></i></span>
                    <span class="sidebar-nav-text">My Markets</span>
                </a>
            </li>
            <li class="sidebar-menu-item">
                <a class="sidebar-nav-item @(currentCtrl == "PickupSlots" ? "active" : "")" asp-area="Farmer" asp-controller="PickupSlots" asp-action="Index" title="Pickup Slots">
                    <span class="nav-icon"><i class="fas fa-clock"></i></span>
                    <span class="sidebar-nav-text">Pickup Slots</span>
                </a>
            </li>

            <li class="sidebar-section-header">
                <span class="sidebar-section-label">Products</span>
            </li>
            <li class="sidebar-menu-item">
                <a class="sidebar-nav-item @(currentCtrl == "Products" && currentAct == "Index" ? "active" : "")" asp-area="Farmer" asp-controller="Products" asp-action="Index" title="My Products">
                    <span class="nav-icon"><i class="fas fa-box-open"></i></span>
                    <span class="sidebar-nav-text">My Products</span>
                </a>
            </li>
            <li class="sidebar-menu-item">
                <a class="sidebar-nav-item @(currentCtrl == "Products" && currentAct == "Create" ? "active" : "")" asp-area="Farmer" asp-controller="Products" asp-action="Create" title="Add Product">
                    <span class="nav-icon"><i class="fas fa-plus-circle"></i></span>
                    <span class="sidebar-nav-text">Add Product</span>
                </a>
            </li>
            <li class="sidebar-menu-item">
                <a class="sidebar-nav-item @(currentCtrl == "Inventory" ? "active" : "")" asp-area="Farmer" asp-controller="Inventory" asp-action="Index" title="Inventory">
                    <span class="nav-icon"><i class="fas fa-warehouse"></i></span>
                    <span class="sidebar-nav-text">Inventory</span>
                </a>
            </li>

            <li class="sidebar-section-header">
                <span class="sidebar-section-label">Orders</span>
            </li>
            <li class="sidebar-menu-item">
                <a class="sidebar-nav-item @(currentCtrl == "Orders" && string.IsNullOrEmpty(orderStatus) ? "active" : "")" asp-area="Farmer" asp-controller="Orders" asp-action="Index" title="Orders">
                    <span class="nav-icon"><i class="fas fa-shopping-cart"></i></span>
                    <span class="sidebar-nav-text">Orders</span>
                </a>
            </li>
            <li class="sidebar-menu-item">
                <a class="sidebar-nav-item @(currentCtrl == "Orders" && orderStatus == "Pending" ? "active" : "")" asp-area="Farmer" asp-controller="Orders" asp-action="Index" asp-route-status="Pending" title="Pending Orders">
                    <span class="nav-icon"><i class="fas fa-hourglass-half"></i></span>
                    <span class="sidebar-nav-text">Pending Orders</span>
                </a>
            </li>

            <li class="sidebar-section-header">
                <span class="sidebar-section-label">Insights</span>
            </li>
            <li class="sidebar-menu-item">
                <a class="sidebar-nav-item @(currentCtrl == "Analytics" ? "active" : "")" asp-area="Farmer" asp-controller="Analytics" asp-action="Index" title="Analytics">
                    <span class="nav-icon"><i class="fas fa-chart-line"></i></span>
                    <span class="sidebar-nav-text">Analytics</span>
                </a>
            </li>
            <li class="sidebar-menu-item">
                <a class="sidebar-nav-item @(currentCtrl == "Reviews" ? "active" : "")" asp-area="Farmer" asp-controller="Reviews" asp-action="Index" title="Reviews">
                    <span class="nav-icon"><i class="fas fa-star"></i></span>
                    <span class="sidebar-nav-text">Reviews</span>
                </a>
            </li>

            <li class="sidebar-section-header">
                <span class="sidebar-section-label">Account</span>
            </li>
            <li class="sidebar-menu-item">
                <a class="sidebar-nav-item @(currentCtrl == "Dashboard" && currentAct == "Notifications" ? "active" : "")" asp-area="Farmer" asp-controller="Dashboard" asp-action="Notifications" title="Notifications">
                    <span class="nav-icon"><i class="fas fa-bell"></i></span>
                    <span class="sidebar-nav-text">Notifications</span>
                </a>
            </li>
            <li class="sidebar-menu-item">
                <a class="sidebar-nav-item @(currentCtrl == "Dashboard" && currentAct == "Settings" ? "active" : "")" asp-area="Farmer" asp-controller="Dashboard" asp-action="Settings" title="Settings">
                    <span class="nav-icon"><i class="fas fa-cog"></i></span>
                    <span class="sidebar-nav-text">Settings</span>
                </a>
            </li>
            <li class="sidebar-menu-item">
                <a class="sidebar-nav-item @(currentCtrl == "Home" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index" title="View Marketplace">
                    <span class="nav-icon"><i class="fas fa-globe"></i></span>
                    <span class="sidebar-nav-text">View Marketplace</span>
                </a>
            </li>
            <li class="sidebar-menu-item">
                <a class="sidebar-nav-item @(currentCtrl == "Home" && currentAct == "Contact" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Contact" title="Contact Support">
                    <span class="nav-icon"><i class="fas fa-headset text-success"></i></span>
                    <span class="sidebar-nav-text">Contact Support</span>
                </a>
            </li>
        </ul>
    </nav>

    <div class="sidebar-footer-fixed">
        <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post" class="w-100">
            @Html.AntiForgeryToken()
            <button type="submit" class="sidebar-signout-btn">
                <i class="fas fa-sign-out-alt"></i>
                <span class="sidebar-nav-text">Sign Out</span>
            </button>
        </form>
    </div>
</aside>

<div class="dashboard-content">
    <header class="dashboard-topbar">
        <div class="d-flex align-items-center gap-3">
            <button id="sidebar-toggle" class="btn btn-sm btn-sidebar-toggle" title="Toggle Sidebar" aria-label="Toggle navigation">
                <i class="fas fa-bars"></i>
            </button>
            <div>
                <h6 style="margin:0;font-size:16px;color:var(--heading);">@ViewData["Title"]</h6>
                @if (ViewData["Subtitle"] != null)
                {
                    <p style="margin:0;font-size:12px;color:var(--muted);">@ViewData["Subtitle"]</p>
                }
            </div>
        </div>
        <div class="d-flex align-items-center gap-3">
            <button class="dark-mode-toggle"></button>
            <a asp-area="Farmer" asp-controller="Dashboard" asp-action="Notifications" class="nav-icon-btn" style="position:relative;" title="Notifications">
                <i class="fas fa-bell"></i>
                <span class="notif-badge" style="@(mlUnread > 0 ? "display:flex" : "display:none")">@mlUnread</span>
            </a>
        </div>
    </header>
    <div class="dashboard-body">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success auto-dismiss" style="border-radius:var(--radius-sm);border-left:4px solid var(--success);">
                <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger auto-dismiss" style="border-radius:var(--radius-sm);border-left:4px solid var(--danger);">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            </div>
        }
        @RenderBody()
    </div>
</div>

<a class="whatsapp-support-btn" href="https://wa.me/92331241604?text=Hello%20MarketLink%20Support" target="_blank" rel="noopener noreferrer" aria-label="Chat with MarketLink Support on WhatsApp" title="WhatsApp Support">
    <i class="fab fa-whatsapp"></i>
</a>

<div class="ai-search-widget">
    <div class="ai-chat-panel">
        <div class="ai-chat-header">
            <div style="width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;font-size:18px;">🤖</div>
            <div>
                <h6>Farmer Assistant</h6>
                <p>Ask about your stock, orders &amp; sales!</p>
            </div>
        </div>
        <div class="ai-chat-messages"></div>
        <div class="ai-chat-input">
            <input type="text" placeholder="Ask a question..." />
            <button type="button"><i class="fas fa-paper-plane" style="font-size:13px;"></i></button>
        </div>
    </div>
    <button class="ai-toggle-btn" title="Farmer Assistant">
        <i class="fas fa-robot"></i>
    </button>
</div>

<div class="toast-container-green"></div>
<script>
    window.MarketLinkRoutes = {
        products: '@Url.Action("Index", "Products", new { area = "" })',
        login: '@Url.Action("Login", "Auth", new { area = "" })',
        cartAdd: '@Url.Action("AddItem", "Cart", new { area = "Customer" })',
        favoriteToggle: '@Url.Action("Toggle", "Favorites", new { area = "Customer" })',
        productBySlug: '@Url.RouteUrl("product-slug", new { slug = "__SLUG__" })',
        assistantAsk: '@Url.Action("Ask", "Assistant", new { area = "Farmer" })'
    };
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
