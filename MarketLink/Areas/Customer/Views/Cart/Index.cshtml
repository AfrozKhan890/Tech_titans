@model MarketLink.Models.CartViewModel
@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="row g-4">
    <div class="col-12 col-lg-8">
        @if (Model.ItemCount == 0)
        {
            <div class="card text-center py-5" style="border:1px dashed var(--border);border-radius:var(--radius);background:var(--card);">
                <div style="font-size:48px;margin-bottom:16px;">🛒</div>
                <h6 style="font-weight:700;margin-bottom:8px;">Your cart is empty</h6>
                <p style="font-size:14px;color:var(--muted);margin-bottom:24px;">Looks like you haven't added any fresh produce yet.</p>
                <div><a asp-controller="Products" asp-action="Index" class="btn btn-primary-green btn-pill px-4">Start Shopping</a></div>
            </div>
        }
        else
        {
            @foreach (var group in Model.Groups)
            {
                <div class="card mb-4" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
                    <div class="card-header d-flex justify-content-between align-items-center" style="background:transparent;border-bottom:1px solid var(--border);padding:16px 20px;">
                        <h6 style="margin:0;font-weight:700;"><i class="fas fa-tractor me-2" style="color:var(--accent-text)"></i>@group.FarmName</h6>
                        <span style="font-size:13px;color:var(--muted);">$@group.Subtotal.ToString("0.00")</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table mb-0 align-middle" style="min-width:620px;">
                            <thead style="background:var(--bg);">
                                <tr>
                                    <th style="padding:12px 20px;border-bottom:none;font-weight:600;color:var(--muted);white-space:nowrap;">Product</th>
                                    <th style="padding:12px 20px;border-bottom:none;font-weight:600;color:var(--muted);white-space:nowrap;">Price</th>
                                    <th style="padding:12px 20px;border-bottom:none;font-weight:600;color:var(--muted);white-space:nowrap;">Quantity</th>
                                    <th style="padding:12px 20px;border-bottom:none;font-weight:600;color:var(--muted);white-space:nowrap;">Total</th>
                                    <th style="padding:12px 20px;border-bottom:none;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in group.Items)
                                {
                                    var stock = item.Product.StockQuantityKg;
                                    <tr>
                                        <td style="padding:16px 20px;">
                                            <div class="d-flex align-items-center gap-3">
                                                <img src="@(string.IsNullOrEmpty(item.Product.ImageUrl) ? "/images/placeholder.svg" : item.Product.ImageUrl)" style="width:50px;height:50px;min-width:50px;border-radius:8px;object-fit:cover;" alt="@item.Product.Name">
                                                <div style="white-space:nowrap;">
                                                    <a asp-area="" asp-controller="Products" asp-action="Details" asp-route-slug="@item.Product.Slug" style="font-weight:600;color:var(--heading);text-decoration:none;">@item.Product.Name</a>
                                                    <div style="font-size:12px;color:var(--muted);">@stock @item.Product.Unit available</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td style="padding:16px 20px;font-weight:600;white-space:nowrap;">$@item.Product.PricePerKg.ToString("0.00")<span style="font-size:12px;color:var(--muted);font-weight:normal;">/@item.Product.Unit</span></td>
                                        <td style="padding:16px 20px;">
                                            @{
                                                var cartQuantities = (System.Text.Json.JsonSerializer.Deserialize<List<int>>(item.Product.AvailableQuantities ?? "[]") ?? new List<int>())
                                                    .Where(q => q > 0).Distinct().OrderBy(q => q).ToList();
                                                if (cartQuantities.Count == 0) cartQuantities.Add(1);
                                                var currentIndex = cartQuantities.IndexOf(item.QuantityKg);
                                            }
                                            <div class="d-inline-flex align-items-center" style="background:var(--bg);border:1px solid var(--border);border-radius:var(--radius-sm);">
                                                <button type="button" class="btn btn-sm btn-link text-muted" onclick="changeQtyStep(@item.Id, @item.QuantityKg, -1, [@string.Join(",", cartQuantities)])" aria-label="Decrease quantity" @(currentIndex <= 0 ? "disabled" : "")><i class="fas fa-minus"></i></button>
                                                <span style="min-width:72px;text-align:center;font-weight:600;">@item.QuantityKg @item.Product.Unit</span>
                                                <button type="button" class="btn btn-sm btn-link text-muted" onclick="changeQtyStep(@item.Id, @item.QuantityKg, 1, [@string.Join(",", cartQuantities)])" aria-label="Increase quantity" @(currentIndex >= cartQuantities.Count - 1 ? "disabled" : "")><i class="fas fa-plus"></i></button>
                                            </div>
                                        </td>
                                        <td style="padding:16px 20px;font-weight:700;color:var(--primary-text);white-space:nowrap;">$@((item.QuantityKg * item.Product.PricePerKg).ToString("0.00"))</td>
                                        <td class="action-column" style="padding:16px 20px;">
                                            <button class="btn btn-sm btn-light text-danger btn-circle shadow-sm" onclick="removeItem(@item.Id, @item.ProductId)" aria-label="Remove item"><i class="fas fa-trash"></i></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (group.Slots.Count == 0)
                    {
                        <div class="card-body" style="padding:16px 20px;">
                            <div class="alert alert-warning mb-0" style="font-size:13px;border-radius:var(--radius-sm);">
                                <i class="fas fa-exclamation-triangle me-1"></i>@group.FarmName has not published a pickup schedule yet, so this basket cannot be checked out.
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>

    <div class="col-12 col-lg-4">
        <div class="card" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);position:sticky;top:100px;">
            <div class="card-header" style="background:transparent;border-bottom:1px solid var(--border);padding:20px;">
                <h5 style="margin:0;font-weight:700;">Order Summary</h5>
            </div>
            <div class="card-body p-4">
                <div class="d-flex justify-content-between mb-3">
                    <span>Subtotal (@Model.ItemCount items)</span>
                    <span style="font-weight:600;color:var(--heading);">$@Model.Total.ToString("0.00")</span>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <span>Service Fee</span>
                    <span style="font-weight:600;color:var(--heading);">$0.00</span>
                </div>
                <hr style="border-color:var(--border);" class="my-3">
                <div class="d-flex justify-content-between mb-4">
                    <span style="font-weight:700;color:var(--heading);font-size:18px;">Total</span>
                    <span style="font-weight:800;color:var(--primary-text);font-size:22px;">$@Model.Total.ToString("0.00")</span>
                </div>

                @if (Model.ItemCount > 0)
                {
                    <form asp-area="Customer" asp-controller="Orders" asp-action="Checkout" method="post">
                        @{ var index = 0; }
                        @foreach (var group in Model.Groups)
                        {
                            <div class="mb-3">
                                <label class="form-label" style="font-size:13px;font-weight:600;">Pickup for @group.FarmName</label>
                                <input type="hidden" name="Pickups[@index].FarmerId" value="@group.FarmerId">
                                @if (group.Slots.Count > 0)
                                {
                                    <select id="pickup-slot-@index" name="Pickups[@index].PickupSlotId" class="form-select mb-2" data-time-input="pickup-time-@index" required>
                                        @foreach (var slot in group.Slots)
                                        {
                                            <option value="@slot.Id" data-day="@((int)slot.DayOfWeek)" data-start="@slot.StartTime.ToString("HH:mm")" data-end="@slot.EndTime.ToString("HH:mm")">@slot.DayOfWeek @slot.StartTime.ToString("hh:mm")–@slot.EndTime.ToString("hh:mm") @(slot.Market != null ? $"· {slot.Market.Name}" : "")</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input type="hidden" name="Pickups[@index].PickupSlotId" value="0">
                                }
                                <input id="pickup-time-@index" type="datetime-local" name="Pickups[@index].PickupTime" class="form-control" required
                                       min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")">
                            </div>
                            index++;
                        }
                        <div class="mb-3">
                            <label class="form-label" style="font-size:13px;font-weight:600;">Order notes (optional)</label>
                            <textarea name="notes" class="form-control" rows="2" maxlength="500" placeholder="Anything the farmer should know?"></textarea>
                        </div>
                        <div class="alert alert-info" style="font-size:12px;padding:10px;border-radius:var(--radius-sm);">
                            <i class="fas fa-info-circle me-1"></i> Payment is collected at pickup (Cash/Card).
                        </div>
                        <button type="submit" class="btn btn-primary-green btn-lg btn-pill w-100 shadow">Complete Checkout</button>
                    </form>
                }
                else
                {
                    <button class="btn btn-secondary btn-lg btn-pill w-100" disabled>Checkout</button>
                }
            </div>
            @if (Model.ItemCount > 0)
            {
                <div class="card-footer d-flex justify-content-between align-items-center" style="background:transparent;border-top:1px solid var(--border);padding:16px 20px;">
                    <form asp-area="Customer" asp-controller="Cart" asp-action="Clear" method="post">
                        <button type="submit" class="btn btn-outline-danger btn-sm btn-pill">Clear Cart</button>
                    </form>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-green btn-sm btn-pill">Continue Shopping</a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function postCart(url, payload) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const res = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify(payload)
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok || data.success === false) {
                ML.Toast.show(data.message || 'Could not update your basket.', 'error');
                return false;
            }
            return true;
        }
        async function changeQtyStep(cartItemId, currentQuantity, direction, allowedQuantities) {
            const index = allowedQuantities.indexOf(currentQuantity);
            const nextIndex = index + direction;
            if (index < 0 || nextIndex < 0 || nextIndex >= allowedQuantities.length) return;
            const quantity = allowedQuantities[nextIndex];
            if (await postCart('/Customer/Cart/UpdateItem', { cartItemId, quantityKg: quantity })) window.location.reload();
        }
        async function removeItem(cartItemId, productId) {
            if (!confirm('Remove this item?')) return;
            if (await postCart('/Customer/Cart/RemoveItem', { cartItemId, productId })) window.location.reload();
        }

        function nextPickupDate(day, startTime) {
            const now = new Date();
            const result = new Date(now);
            let daysAhead = (day - now.getDay() + 7) % 7;
            const parts = startTime.split(':').map(Number);
            result.setDate(result.getDate() + daysAhead);
            result.setHours(parts[0], parts[1], 0, 0);
            if (result <= now) result.setDate(result.getDate() + 7);
            return result;
        }

        function formatDateTimeLocal(date) {
            const pad = value => String(value).padStart(2, '0');
            return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
        }

        function syncPickupDate(select) {
            const option = select.options[select.selectedIndex];
            const input = document.getElementById(select.dataset.timeInput);
            if (!option || !input) return;
            const day = Number(option.dataset.day);
            const start = option.dataset.start || '08:00';
            const end = option.dataset.end || '18:00';
            const date = nextPickupDate(day, start);
            input.value = formatDateTimeLocal(date);
            input.min = formatDateTimeLocal(new Date());
            input.max = formatDateTimeLocal(new Date(date.getFullYear(), date.getMonth(), date.getDate(), ...end.split(':').map(Number)));
        }

        document.querySelectorAll('select[data-time-input]').forEach(select => {
            select.addEventListener('change', () => syncPickupDate(select));
            syncPickupDate(select);
        });
    </script>
}
