@model IEnumerable<MarketLink.Models.Review>
@{
    ViewData["Title"] = "My Reviews";
    var farmers = ViewBag.Farmers as List<MarketLink.Areas.Customer.Controllers.FarmerOption> ?? new List<MarketLink.Areas.Customer.Controllers.FarmerOption>();
    var reviewedFarmerIds = Model.Where(r => r.ProductId == null && r.FarmerId != null).Select(r => r.FarmerId!.Value).ToHashSet();
}

<div class="container-fluid px-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h4 class="fw-bold mb-1" style="color:var(--heading);"><i class="fas fa-star me-2 text-warning"></i>My Product & Farmer Reviews</h4>
            <p class="text-muted small mb-0">Feedback and ratings you've shared with the local agricultural community.</p>
        </div>
        <a asp-area="" asp-controller="Products" asp-action="Index" class="btn btn-outline-green btn-sm">
            <i class="fas fa-leaf me-1"></i> Browse Products
        </a>
    </div>


    <div class="card border-0 mb-4" style="background:var(--card);border-radius:var(--radius);border:1px solid var(--border);box-shadow:var(--shadow-sm);">
        <div class="card-body p-4">
            <h6 class="fw-bold mb-3" style="color:var(--heading);"><i class="fas fa-pen me-2 text-warning"></i>Write a Review</h6>
            <form asp-area="Customer" asp-controller="Reviews" asp-action="SubmitFarmer" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnTo" value="reviews" />
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label small fw-semibold">Farmer</label>
                        <select name="farmerId" class="form-select" required>
                            <option value="">Select a farmer...</option>
                            @foreach (var f in farmers)
                            {
                                <option value="@f.Id" disabled="@reviewedFarmerIds.Contains(f.Id)">@f.Name@(reviewedFarmerIds.Contains(f.Id) ? " (already reviewed)" : "")</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label small fw-semibold">Rating</label>
                        <select name="rating" class="form-select" required>
                            <option value="5">5 - Excellent</option>
                            <option value="4">4 - Very good</option>
                            <option value="3">3 - Good</option>
                            <option value="2">2 - Fair</option>
                            <option value="1">1 - Poor</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Title <span class="text-muted fw-normal">(optional)</span></label>
                        <input type="text" name="title" class="form-control" maxlength="120" placeholder="Short summary" />
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Your message</label>
                        <textarea name="comment" class="form-control" rows="3" maxlength="2000" required placeholder="Share your experience with this farmer..."></textarea>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary-green btn-pill px-4"><i class="fas fa-paper-plane me-1"></i>Submit Review</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 text-center py-5" style="background:var(--card);border-radius:var(--radius);border:1px dashed var(--border);">
            <div class="card-body">
                <div style="font-size:48px;margin-bottom:16px;">⭐</div>
                <h5 class="fw-bold" style="color:var(--heading);">No reviews yet</h5>
                <p class="text-muted" style="max-width:400px;margin:0 auto 20px;">Use the form above to review any farmer and help other conscious consumers.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var r in Model)
            {
                <div class="col-12 col-md-6">
                    <div class="card h-100 border-0" style="background:var(--card);border-radius:var(--radius);border:1px solid var(--border);box-shadow:var(--shadow-sm);">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    @if (r.Product != null)
                                    {
                                        <h6 class="fw-bold mb-1"><a asp-area="" asp-controller="Products" asp-action="Details" asp-route-slug="@r.Product.Slug" style="color:var(--heading);text-decoration:none;">@r.Product.Name</a></h6>
                                        <div class="small text-muted"><i class="fas fa-box me-1"></i>Product Review</div>
                                    }
                                    else if (r.Farmer != null)
                                    {
                                        <h6 class="fw-bold mb-1"><a asp-area="" asp-controller="Farmers" asp-action="Details" asp-route-id="@r.Farmer.Id" style="color:var(--heading);text-decoration:none;">@r.Farmer.FarmName</a></h6>
                                        <div class="small text-muted"><i class="fas fa-tractor me-1"></i>Farmer Review</div>
                                    }
                                </div>
                                <div class="text-warning small">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="fas fa-star @(i <= r.Rating ? "" : "text-muted opacity-25")"></i>
                                    }
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(r.Title))
                            {
                                <div class="fw-bold small mb-1" style="color:var(--heading);">@r.Title</div>
                            }
                            <p class="text-muted small mb-3">@r.Comment</p>

                            @if (!string.IsNullOrEmpty(r.FarmerResponse))
                            {
                                <div class="p-3 rounded mb-2" style="background:rgba(92,111,43,0.06);border-left:3px solid var(--primary);">
                                    <div class="fw-bold small" style="color:var(--primary-text);"><i class="fas fa-reply me-1"></i>Farmer's Response:</div>
                                    <div class="small text-muted">@r.FarmerResponse</div>
                                </div>
                            }

                            <div class="text-muted" style="font-size:11px;">
                                Reviewed on @r.CreatedAt.ToString("MMM dd, yyyy")
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
