@model FarmerEditViewModel
@{
    ViewData["Title"] = $"Edit Farmer - {Model.StallName}";
}

<div class="mb-4">
    <a asp-action="Details" asp-route-id="@Model.FarmerId" class="small text-muted"><i class="fa-solid fa-arrow-left me-1"></i>Back to Farmer</a>
    <h3 class="mb-0 mt-1">Edit Farmer</h3>
</div>

<div class="ml-card" style="max-width:760px;">
    <form asp-action="Edit" asp-route-id="@Model.FarmerId" method="post" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="FarmerId" />

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2 small">
                <div asp-validation-summary="ModelOnly"></div>
            </div>
        }

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="StallName" class="form-label small"></label>
                <input asp-for="StallName" class="form-control" />
                <span asp-validation-for="StallName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ContactPerson" class="form-label small"></label>
                <input asp-for="ContactPerson" class="form-control" />
                <span asp-validation-for="ContactPerson" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Phone" class="form-label small"></label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Email" class="form-label small"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Address" class="form-label small"></label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="MarketId" class="form-label small"></label>
                <select asp-for="MarketId" class="form-select">
                    <option value="">-- No market assigned --</option>
                    @foreach (var m in Model.Markets)
                    {
                        <option value="@m.MarketId" selected="@(Model.MarketId == m.MarketId)">@m.MarketName</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="OperatingDays" class="form-label small"></label>
                <input asp-for="OperatingDays" class="form-control" placeholder="e.g. Sat, Sun" />
            </div>
            <div class="col-md-6">
                <label asp-for="PickupWindowStart" class="form-label small"></label>
                <input asp-for="PickupWindowStart" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="PickupWindowEnd" class="form-label small"></label>
                <input asp-for="PickupWindowEnd" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Status" class="form-label small"></label>
                <select asp-for="Status" class="form-select">
                    @foreach (var status in Enum.GetValues(typeof(FarmerStatus)).Cast<FarmerStatus>())
                    {
                        <option value="@status" selected="@(Model.Status == status)">@status</option>
                    }
                </select>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-ml-primary"><i class="fa-solid fa-floppy-disk me-1"></i>Save Changes</button>
            <a asp-action="Details" asp-route-id="@Model.FarmerId" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
