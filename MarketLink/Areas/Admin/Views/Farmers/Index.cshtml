@model FarmerIndexViewModel
@{
    ViewData["Title"] = "Farmers";
    var routeValues = new Dictionary<string, string?>
    {
        ["SearchTerm"] = Model.Filter.SearchTerm,
        ["Status"] = Model.Filter.Status?.ToString(),
        ["MarketId"] = Model.Filter.MarketId?.ToString(),
        ["PageSize"] = Model.Filter.PageSize.ToString()
    };
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="mb-0">Farmers</h3>
        <div class="text-muted small">View, approve, and manage farmer registrations.</div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success py-2 small">@TempData["SuccessMessage"]</div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="ml-stat-card">
            <div class="ml-stat-icon primary"><i class="fa-solid fa-tractor"></i></div>
            <div><div class="ml-stat-value">@Model.TotalFarmers</div><div class="ml-stat-label">Total Farmers</div></div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="ml-stat-card">
            <div class="ml-stat-icon accent"><i class="fa-solid fa-hourglass-half"></i></div>
            <div><div class="ml-stat-value">@Model.PendingCount</div><div class="ml-stat-label">Pending</div></div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="ml-stat-card">
            <div class="ml-stat-icon success"><i class="fa-solid fa-circle-check"></i></div>
            <div><div class="ml-stat-value">@Model.ApprovedCount</div><div class="ml-stat-label">Approved</div></div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="ml-stat-card">
            <div class="ml-stat-icon secondary"><i class="fa-solid fa-ban"></i></div>
            <div><div class="ml-stat-value">@Model.SuspendedCount</div><div class="ml-stat-label">Suspended</div></div>
        </div>
    </div>
</div>

<div class="ml-card mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small mb-1">Search</label>
            <input type="text" name="SearchTerm" value="@Model.Filter.SearchTerm" class="form-control form-control-sm" placeholder="Stall name, contact, email, phone..." />
        </div>
        <div class="col-md-3">
            <label class="form-label small mb-1">Status</label>
            <select name="Status" class="form-select form-select-sm">
                <option value="">All statuses</option>
                @foreach (var status in Enum.GetValues(typeof(FarmerStatus)).Cast<FarmerStatus>())
                {
                    <option value="@status" selected="@(Model.Filter.Status == status)">@status</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small mb-1">Market</label>
            <select name="MarketId" class="form-select form-select-sm">
                <option value="">All markets</option>
                @foreach (var market in Model.Markets)
                {
                    <option value="@market.MarketId" selected="@(Model.Filter.MarketId == market.MarketId)">@market.MarketName</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-ml-primary btn-sm flex-grow-1"><i class="fa-solid fa-filter me-1"></i>Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
        </div>
    </form>
</div>

<div class="ml-card">
    @if (Model.Result.Items.Any())
    {
        <div class="table-responsive">
            <table class="table ml-table mb-0">
                <thead>
                    <tr>
                        <th>Stall / Business</th>
                        <th>Contact</th>
                        <th>Market</th>
                        <th>Operating Days</th>
                        <th>Registered</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model.Result.Items)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@f.StallName</div>
                                <div class="small text-muted">@f.Email</div>
                            </td>
                            <td>
                                <div>@f.ContactPerson</div>
                                <div class="small text-muted">@f.Phone</div>
                            </td>
                            <td>@(f.Market?.MarketName ?? "-")</td>
                            <td>@(f.OperatingDays ?? "-")</td>
                            <td>@f.RegisteredAt.ToString("dd MMM yyyy")</td>
                            <td><span class="ml-badge @StatusBadgeHelper.For(f.Status)">@f.Status</span></td>
                            <td class="text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">Actions</button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" asp-action="Details" asp-route-id="@f.FarmerId"><i class="fa-regular fa-eye me-2"></i>View Details</a></li>
                                        <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@f.FarmerId"><i class="fa-regular fa-pen-to-square me-2"></i>Edit</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                        @if (f.Status != FarmerStatus.Approved)
                                        {
                                            <li>
                                                <form asp-action="Approve" asp-route-id="@f.FarmerId" method="post" data-confirm="Approve this farmer's registration?">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                    <button type="submit" class="dropdown-item"><i class="fa-solid fa-check me-2"></i>Approve</button>
                                                </form>
                                            </li>
                                        }
                                        @if (f.Status != FarmerStatus.Suspended)
                                        {
                                            <li>
                                                <form asp-action="Suspend" asp-route-id="@f.FarmerId" method="post" data-confirm="Suspend this farmer? They will not be able to list products.">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                    <button type="submit" class="dropdown-item text-danger"><i class="fa-solid fa-ban me-2"></i>Suspend</button>
                                                </form>
                                            </li>
                                        }
                                        @if (f.Status == FarmerStatus.Inactive)
                                        {
                                            <li>
                                                <form asp-action="Activate" asp-route-id="@f.FarmerId" method="post" data-confirm="Reactivate this farmer?">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                    <button type="submit" class="dropdown-item"><i class="fa-solid fa-rotate-left me-2"></i>Activate</button>
                                                </form>
                                            </li>
                                        }
                                        else
                                        {
                                            <li>
                                                <form asp-action="Deactivate" asp-route-id="@f.FarmerId" method="post" data-confirm="Deactivate this farmer?">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                    <button type="submit" class="dropdown-item text-danger"><i class="fa-solid fa-power-off me-2"></i>Deactivate</button>
                                                </form>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
            <span class="text-muted small">
                Showing @((Model.Result.PageNumber - 1) * Model.Result.PageSize + 1)–@(Math.Min(Model.Result.PageNumber * Model.Result.PageSize, Model.Result.TotalCount)) of @Model.Result.TotalCount farmers
            </span>
            @{
                ViewData["RouteValues"] = routeValues;
            }
            @await Html.PartialAsync("_Pagination", Model.Result.ToPagingMeta())
        </div>
    }
    else
    {
        <div class="ml-empty-state">
            <i class="fa-solid fa-tractor d-block"></i>
            No farmers found
        </div>
    }
</div>
