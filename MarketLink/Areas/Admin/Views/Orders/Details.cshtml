@model OrderDetailsViewModel
@{
    ViewData["Title"] = $"Order #{Model.Order.OrderId}";
    var o = Model.Order;
}

<div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
    <div>
        <a asp-action="Index" class="small text-muted"><i class="fa-solid fa-arrow-left me-1"></i>Back to Orders</a>
        <h3 class="mb-0 mt-1">Order #@o.OrderId</h3>
        <span class="ml-badge @StatusBadgeHelper.For(o.OrderStatus) mt-1 d-inline-block">@o.OrderStatus</span>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="ml-card mb-3">
            <h6 class="mb-3">Order Summary</h6>
            <dl class="row mb-0 small">
                <dt class="col-12 col-sm-5 text-muted">Order Date</dt><dd class="col-12 col-sm-7">@o.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</dd>
                <dt class="col-12 col-sm-5 text-muted">Status</dt><dd class="col-12 col-sm-7"><span class="ml-badge @StatusBadgeHelper.For(o.OrderStatus)">@o.OrderStatus</span></dd>
                <dt class="col-12 col-sm-5 text-muted">Pickup Date</dt><dd class="col-12 col-sm-7">@(o.PickupDate.HasValue ? o.PickupDate.Value.ToString("dd MMM yyyy") : "-")</dd>
                <dt class="col-12 col-sm-5 text-muted">Pickup Time</dt><dd class="col-12 col-sm-7">@(o.PickupTime.HasValue ? o.PickupTime.Value.ToString(@"hh\:mm") : "-")</dd>
                <dt class="col-12 col-sm-5 text-muted">Total Amount</dt><dd class="col-12 col-sm-7 fw-semibold">$@o.TotalAmount.ToString("N2")</dd>
                <dt class="col-12 col-sm-5 text-muted">Payment</dt><dd class="col-12 col-sm-7">Cash / at pickup</dd>
            </dl>
        </div>

        <div class="ml-card mb-3">
            <h6 class="mb-3">Customer</h6>
            @if (o.Customer != null)
            {
                <dl class="row mb-0 small">
                    <dt class="col-12 col-sm-5 text-muted">Name</dt><dd class="col-12 col-sm-7">@o.Customer.FullName</dd>
                    <dt class="col-12 col-sm-5 text-muted">Email</dt><dd class="col-12 col-sm-7">@o.Customer.Email</dd>
                    <dt class="col-12 col-sm-5 text-muted">Phone</dt><dd class="col-12 col-sm-7">@(o.Customer.Phone ?? "-")</dd>
                </dl>
                <a asp-area="Admin" asp-controller="Customers" asp-action="Details" asp-route-id="@o.Customer.CustomerId" class="small">View customer profile <i class="fa-solid fa-arrow-right ms-1"></i></a>
            }
            else
            {
                <div class="text-muted small">Customer information unavailable</div>
            }
        </div>

        <div class="ml-card">
            <h6 class="mb-3">Farmer</h6>
            @if (o.Farmer != null)
            {
                <dl class="row mb-0 small">
                    <dt class="col-12 col-sm-5 text-muted">Stall</dt><dd class="col-12 col-sm-7">@o.Farmer.StallName</dd>
                    <dt class="col-12 col-sm-5 text-muted">Contact</dt><dd class="col-12 col-sm-7">@o.Farmer.ContactPerson</dd>
                    <dt class="col-12 col-sm-5 text-muted">Phone</dt><dd class="col-12 col-sm-7">@o.Farmer.Phone</dd>
                </dl>
                <a asp-area="Admin" asp-controller="Farmers" asp-action="Details" asp-route-id="@o.Farmer.FarmerId" class="small">View farmer profile <i class="fa-solid fa-arrow-right ms-1"></i></a>
            }
            else
            {
                <div class="text-muted small">Farmer information unavailable</div>
            }
        </div>
    </div>

    <div class="col-lg-8">
        <div class="ml-card">
            <h6 class="mb-3">Items Ordered</h6>
            @if (o.OrderItems.Any())
            {
                <div class="table-responsive">
                    <table class="table ml-table mb-0">
                        <thead><tr><th>Product</th><th>Unit Price</th><th>Quantity</th><th class="text-end">Line Total</th></tr></thead>
                        <tbody>
                            @foreach (var item in o.OrderItems)
                            {
                                <tr>
                                    <td>@(item.Product?.Name ?? "-")</td>
                                    <td>$@item.UnitPrice.ToString("N2")</td>
                                    <td>@item.Quantity</td>
                                    <td class="text-end">$@item.LineTotal.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end fw-semibold">Total</td>
                                <td class="text-end fw-semibold">$@o.TotalAmount.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="ml-empty-state"><i class="fa-solid fa-box-open d-block"></i>No items found for this order</div>
            }
        </div>
    </div>
</div>
