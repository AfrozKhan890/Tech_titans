@model AnalyticsViewModel
@{
    ViewData["Title"] = "Analytics";
    var f = Model.Filter;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="mb-0">Analytics</h3>
        <div class="text-muted small">Trends and patterns across orders, revenue, products, and farmers.</div>
    </div>
    <form method="get" asp-action="Index" class="d-flex gap-2">
        <select name="Months" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="3" selected="@(f.Months == 3)">Last 3 months</option>
            <option value="6" selected="@(f.Months == 6)">Last 6 months</option>
            <option value="12" selected="@(f.Months == 12)">Last 12 months</option>
        </select>
    </form>
</div>

@* ---------- Snapshot KPIs ---------- *@
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="ml-stat-card">
            <div class="ml-stat-icon primary"><i class="fa-solid fa-basket-shopping"></i></div>
            <div>
                <div class="ml-stat-value">@Model.TotalOrders</div>
                <div class="ml-stat-label">Total Orders (all time)</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="ml-stat-card">
            <div class="ml-stat-icon accent"><i class="fa-solid fa-sack-dollar"></i></div>
            <div>
                <div class="ml-stat-value">$@Model.TotalRevenue.ToString("N2")</div>
                <div class="ml-stat-label">Total Revenue</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="ml-stat-card">
            <div class="ml-stat-icon success"><i class="fa-solid fa-tractor"></i></div>
            <div>
                <div class="ml-stat-value">@Model.TotalFarmers</div>
                <div class="ml-stat-label">Active Farmers</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="ml-stat-card">
            <div class="ml-stat-icon secondary"><i class="fa-solid fa-users"></i></div>
            <div>
                <div class="ml-stat-value">@Model.TotalCustomers</div>
                <div class="ml-stat-label">Total Customers</div>
            </div>
        </div>
    </div>
</div>

@* ---------- Revenue + Orders trend ---------- *@
<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="ml-card h-100">
            <h6 class="mb-3">Revenue Trend</h6>
            @if (Model.RevenueTrend.Any(r => r.Revenue > 0))
            {
                <div class="ml-chart-wrap ml-chart-tall">
                    <canvas id="analyticsRevenueChart"></canvas>
                </div>
            }
            else
            {
                <div class="ml-empty-state py-4">
                    <i class="fa-regular fa-chart-bar d-block"></i>
                    No revenue recorded in this window
                </div>
            }
        </div>
    </div>
    <div class="col-lg-4">
        <div class="ml-card h-100">
            <h6 class="mb-3">Order Status Mix</h6>
            @if (Model.OrderStatusBreakdown.Any())
            {
                <div class="ml-chart-wrap">
                    <canvas id="analyticsStatusChart"></canvas>
                </div>
            }
            else
            {
                <div class="ml-empty-state py-4">
                    <i class="fa-regular fa-chart-bar d-block"></i>
                    No orders recorded yet
                </div>
            }
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-12">
        <div class="ml-card">
            <h6 class="mb-3">Orders Over Time</h6>
            @if (Model.OrderTrend.Any(o => o.OrderCount > 0))
            {
                <div class="ml-chart-wrap ml-chart-short">
                    <canvas id="analyticsOrderTrendChart"></canvas>
                </div>
            }
            else
            {
                <div class="ml-empty-state py-4">
                    <i class="fa-regular fa-chart-line d-block"></i>
                    No orders in this window
                </div>
            }
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    @* ---------- Orders by Market ---------- *@
    <div class="col-lg-6">
        <div class="ml-card h-100">
            <h6 class="mb-3">Orders by Market</h6>
            @if (Model.OrdersByMarket.Any())
            {
                <div class="ml-chart-wrap">
                    <canvas id="analyticsMarketChart"></canvas>
                </div>
            }
            else
            {
                <div class="ml-empty-state py-4">
                    <i class="fa-solid fa-store d-block"></i>
                    No market orders recorded
                </div>
            }
        </div>
    </div>

    @* ---------- Top Products ---------- *@
    <div class="col-lg-6">
        <div class="ml-card h-100">
            <h6 class="mb-3">Top Products</h6>
            @if (Model.TopProducts.Any())
            {
                <div class="ml-chart-wrap">
                    <canvas id="analyticsProductsChart"></canvas>
                </div>
            }
            else
            {
                <div class="ml-empty-state py-4">
                    <i class="fa-solid fa-carrot d-block"></i>
                    No product sales yet
                </div>
            }
        </div>
    </div>
</div>

<div class="row g-3">
    @* ---------- Top Farmers ---------- *@
    <div class="col-lg-12">
        <div class="ml-card">
            <h6 class="mb-3">Most Active Farmers</h6>
            @if (Model.TopFarmers.Any(tf => tf.OrderCount > 0))
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var farmer in Model.TopFarmers.Where(tf => tf.OrderCount > 0))
                    {
                        <li class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <span>@farmer.StallName</span>
                            <span class="ml-badge ml-badge-approved">@farmer.OrderCount orders</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="ml-empty-state">
                    <i class="fa-solid fa-tractor d-block"></i>
                    No farmer activity yet
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js"></script>
    <script>
        @if (Model.RevenueTrend.Any(r => r.Revenue > 0))
        {
            <text>
            new Chart(document.getElementById('analyticsRevenueChart'), {
                type: 'line',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueTrend.Select(r => r.MonthLabel))),
                    datasets: [{
                        label: 'Revenue ($)',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueTrend.Select(r => r.Revenue))),
                        borderColor: '#5C6F2B',
                        backgroundColor: 'rgba(92,111,43,0.12)',
                        tension: 0.35,
                        fill: true,
                        pointBackgroundColor: '#DE802B'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true } }
                }
            });
            </text>
        }

        @if (Model.OrderTrend.Any(o => o.OrderCount > 0))
        {
            <text>
            new Chart(document.getElementById('analyticsOrderTrendChart'), {
                type: 'bar',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OrderTrend.Select(o => o.MonthLabel))),
                    datasets: [{
                        label: 'Orders',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OrderTrend.Select(o => o.OrderCount))),
                        backgroundColor: 'rgba(222,128,43,0.75)',
                        borderColor: '#DE802B',
                        borderWidth: 1,
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                }
            });
            </text>
        }

        @if (Model.OrderStatusBreakdown.Any())
        {
            <text>
            new Chart(document.getElementById('analyticsStatusChart'), {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OrderStatusBreakdown.Select(s => s.Status))),
                    datasets: [{
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OrderStatusBreakdown.Select(s => s.Count))),
                        backgroundColor: ['#D7E4F0', '#E3D6F5', '#DE802B', '#D8E983', '#F3D0CB']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom', labels: { boxWidth: 12 } } }
                }
            });
            </text>
        }

        @if (Model.OrdersByMarket.Any())
        {
            <text>
            new Chart(document.getElementById('analyticsMarketChart'), {
                type: 'bar',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OrdersByMarket.Select(m => m.MarketName))),
                    datasets: [{
                        label: 'Revenue ($)',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OrdersByMarket.Select(m => m.Revenue))),
                        backgroundColor: 'rgba(92,111,43,0.75)',
                        borderRadius: 4
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { x: { beginAtZero: true } }
                }
            });
            </text>
        }

        @if (Model.TopProducts.Any())
        {
            <text>
            new Chart(document.getElementById('analyticsProductsChart'), {
                type: 'bar',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopProducts.Select(p => p.ProductName))),
                    datasets: [{
                        label: 'Units sold',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopProducts.Select(p => p.UnitsSold))),
                        backgroundColor: 'rgba(222,128,43,0.75)',
                        borderRadius: 4
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { x: { beginAtZero: true, ticks: { precision: 0 } } }
                }
            });
            </text>
        }
    </script>
}