@model ReviewIndexViewModel
@{
    ViewData["Title"] = "Reviews";
    var routeValues = new Dictionary<string, string?>
    {
        ["SearchTerm"] = Model.Filter.SearchTerm,
        ["Rating"] = Model.Filter.Rating?.ToString(),
        ["FarmerId"] = Model.Filter.FarmerId?.ToString(),
        ["IsRemoved"] = Model.Filter.IsRemoved?.ToString(),
        ["PageSize"] = Model.Filter.PageSize.ToString()
    };
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="mb-0">Reviews</h3>
        <div class="text-muted small">Moderate customer reviews left on farmers and products.</div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success py-2 small">@TempData["SuccessMessage"]</div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="ml-stat-card">
            <div class="ml-stat-icon primary"><i class="fa-solid fa-star"></i></div>
            <div><div class="ml-stat-value">@Model.TotalReviews</div><div class="ml-stat-label">Total Reviews</div></div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="ml-stat-card">
            <div class="ml-stat-icon success"><i class="fa-regular fa-eye"></i></div>
            <div><div class="ml-stat-value">@Model.VisibleCount</div><div class="ml-stat-label">Visible</div></div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="ml-stat-card">
            <div class="ml-stat-icon secondary"><i class="fa-solid fa-ban"></i></div>
            <div><div class="ml-stat-value">@Model.RemovedCount</div><div class="ml-stat-label">Removed</div></div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="ml-stat-card">
            <div class="ml-stat-icon accent"><i class="fa-solid fa-chart-simple"></i></div>
            <div><div class="ml-stat-value">@Model.AverageRating.ToString("N1")</div><div class="ml-stat-label">Avg. Rating (visible)</div></div>
        </div>
    </div>
</div>

<div class="ml-card mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label small mb-1">Search</label>
            <input type="text" name="SearchTerm" value="@Model.Filter.SearchTerm" class="form-control form-control-sm" placeholder="Customer, farmer, product, comment..." />
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1">Rating</label>
            <select name="Rating" class="form-select form-select-sm">
                <option value="">All ratings</option>
                @for (int i = 5; i >= 1; i--)
                {
                    <option value="@i" selected="@(Model.Filter.Rating == i)">@i star@(i == 1 ? "" : "s")</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small mb-1">Farmer</label>
            <select name="FarmerId" class="form-select form-select-sm">
                <option value="">All farmers</option>
                @foreach (var f in Model.Farmers)
                {
                    <option value="@f.FarmerId" selected="@(Model.Filter.FarmerId == f.FarmerId)">@f.StallName</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small mb-1">Visibility</label>
            <select name="IsRemoved" class="form-select form-select-sm">
                <option value="">All reviews</option>
                <option value="false" selected="@(Model.Filter.IsRemoved == false)">Visible only</option>
                <option value="true" selected="@(Model.Filter.IsRemoved == true)">Removed only</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-ml-primary btn-sm flex-grow-1"><i class="fa-solid fa-filter"></i></button>
        </div>
        <div class="col-12">
            <a asp-action="Index" class="small text-muted">Reset all filters</a>
        </div>
    </form>
</div>

<div class="ml-card">
    @if (Model.Result.Items.Any())
    {
        <div class="table-responsive">
            <table class="table ml-table mb-0">
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Farmer / Product</th>
                        <th>Rating</th>
                        <th>Comment</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Result.Items)
                    {
                        <tr>
                            <td>@(r.Customer?.FullName ?? "-")</td>
                            <td>
                                <div>@(r.Farmer?.StallName ?? "-")</div>
                                @if (r.Product != null)
                                {
                                    <div class="small text-muted">@r.Product.Name</div>
                                }
                            </td>
                            <td>
                                <span class="text-warning">
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        <i class="fa-solid fa-star @(i < r.Rating ? "" : "text-muted opacity-25")"></i>
                                    }
                                </span>
                            </td>
                            <td class="small" style="max-width: 260px;">
                                @if (!string.IsNullOrWhiteSpace(r.Comment))
                                {
                                    var preview = r.Comment.Length > 80 ? r.Comment.Substring(0, 80) + "…" : r.Comment;
                                    @preview
                                }
                                else
                                {
                                    @:-
                                }
                            </td>
                            <td class="small text-muted">@r.ReviewDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (r.IsRemoved)
                                {
                                    <span class="ml-badge ml-badge-cancelled">Removed</span>
                                }
                                else
                                {
                                    <span class="ml-badge ml-badge-active">Visible</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@r.ReviewId" class="btn btn-sm btn-outline-secondary"><i class="fa-regular fa-eye me-1"></i>View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
            <span class="text-muted small">
                Showing @((Model.Result.PageNumber - 1) * Model.Result.PageSize + 1)–@(Math.Min(Model.Result.PageNumber * Model.Result.PageSize, Model.Result.TotalCount)) of @Model.Result.TotalCount reviews
            </span>
            @{
                ViewData["RouteValues"] = routeValues;
            }
            @await Html.PartialAsync("_Pagination", Model.Result.ToPagingMeta())
        </div>
    }
    else
    {
        <div class="ml-empty-state">
            <i class="fa-solid fa-star d-block"></i>
            No reviews found
        </div>
    }
</div>
