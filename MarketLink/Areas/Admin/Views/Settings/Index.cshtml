@model SettingsViewModel
@{
    ViewData["Title"] = "Settings";
    var pw = ViewBag.PasswordModel as ChangePasswordViewModel
             ?? new ChangePasswordViewModel();
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="mb-0">Settings</h3>
        <div class="text-muted small">Configure platform details, notifications.</div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success py-2 small">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger py-2 small">@TempData["ErrorMessage"]</div>
}

<form asp-action="Index" method="post" id="settingsForm" novalidate>
    @Html.AntiForgeryToken()

    <div class="row g-3 mb-4">
        @* ---------- General ---------- *@
        <div class="col-lg-6">
            <div class="ml-card h-100">
                <h6 class="mb-3"><i class="fa-solid fa-sliders me-2"></i>General</h6>
                <div class="mb-3">
                    <label asp-for="PlatformName" class="form-label small"></label>
                    <input asp-for="PlatformName" class="form-control form-control-sm" />
                    <span asp-validation-for="PlatformName" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ContactEmail" class="form-label small"></label>
                    <input asp-for="ContactEmail" class="form-control form-control-sm" />
                    <span asp-validation-for="ContactEmail" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ContactPhone" class="form-label small"></label>
                    <input asp-for="ContactPhone" class="form-control form-control-sm" id="ContactPhone"
                           placeholder="e.g. +92 300 1234567" />
                    <span asp-validation-for="ContactPhone" class="text-danger small"></span>
                </div>
                <div class="mb-0">
                    <label asp-for="DefaultMapProvider" class="form-label small"></label>
                    <select asp-for="DefaultMapProvider" class="form-select form-select-sm">
                        <option value="OpenStreetMap">OpenStreetMap</option>
                        <option value="Google Maps">Google Maps</option>
                    </select>
                    <span asp-validation-for="DefaultMapProvider" class="text-danger small"></span>
                </div>
            </div>
        </div>

    <div class="d-flex gap-2 mb-4">
        <button type="submit" class="btn btn-ml-primary"><i class="fa-solid fa-floppy-disk me-1"></i>Save Settings</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

@* ---------- Change password ---------- *@
<div class="ml-card" style="max-width:640px;">
    <h6 class="mb-3"><i class="fa-solid fa-key me-2"></i>Change Password</h6>
    <form asp-area="Admin" asp-controller="Profile" asp-action="ChangePassword" method="post" novalidate>
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label asp-for="@pw.CurrentPassword" class="form-label small">Current Password</label>
            <div class="input-group input-group-sm">
                <input name="CurrentPassword" type="password" class="form-control password-field" required />
                <span class="input-group-text password-toggle" style="cursor:pointer;">
                    <i class="fa-solid fa-eye"></i>
                </span>
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label small">New Password</label>
            <div class="input-group input-group-sm">
                <input name="NewPassword" id="settingsNewPassword" type="password"
                       class="form-control password-field" minlength="8" required />
                <span class="input-group-text password-toggle" style="cursor:pointer;">
                    <i class="fa-solid fa-eye"></i>
                </span>
            </div>
            <ul class="pw-rules-settings" id="settingsPwRules">
                <li id="sRuleLength"><i class="fa-solid fa-circle"></i> At least 8 characters</li>
                <li id="sRuleUpper"><i class="fa-solid fa-circle"></i> One uppercase letter</li>
                <li id="sRuleLower"><i class="fa-solid fa-circle"></i> One lowercase letter</li>
                <li id="sRuleNumber"><i class="fa-solid fa-circle"></i> One number</li>
                <li id="sRuleSpecial"><i class="fa-solid fa-circle"></i> One special character</li>
            </ul>
        </div>
        <div class="mb-3">
            <label class="form-label small">Confirm New Password</label>
            <div class="input-group input-group-sm">
                <input name="ConfirmPassword" type="password" class="form-control password-field" required />
                <span class="input-group-text password-toggle" style="cursor:pointer;">
                    <i class="fa-solid fa-eye"></i>
                </span>
            </div>
        </div>
        <button type="submit" class="btn btn-ml-accent">
            <i class="fa-solid fa-key me-1"></i>Update Password
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@18.2.1/build/css/intlTelInput.css" />
    <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@18.2.1/build/js/intlTelInput.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@18.2.1/build/js/utils.js"></script>
    <script>
        (function () {
            // Phone input with intl-tel-input (same pattern as SIOMS Settings).
            var phoneInput = document.getElementById('ContactPhone');
            if (phoneInput && window.intlTelInput) {
                var iti = window.intlTelInput(phoneInput, {
                    initialCountry: 'pk',
                    preferredCountries: ['pk', 'us', 'gb', 'ae', 'in', 'sa', 'ca', 'au'],
                    separateDialCode: true,
                    utilsScript: 'https://cdn.jsdelivr.net/npm/intl-tel-input@18.2.1/build/js/utils.js',
                    autoPlaceholder: 'polite',
                    nationalMode: false
                });
                phoneInput._iti = iti;
            }

            // Password show/hide toggles.
            document.querySelectorAll('.password-toggle').forEach(function (toggle) {
                toggle.addEventListener('click', function () {
                    var input = this.closest('.input-group').querySelector('.password-field');
                    var icon = this.querySelector('i');
                    if (!input) return;
                    if (input.type === 'password') {
                        input.type = 'text';
                        icon.classList.remove('fa-eye');
                        icon.classList.add('fa-eye-slash');
                    } else {
                        input.type = 'password';
                        icon.classList.remove('fa-eye-slash');
                        icon.classList.add('fa-eye');
                    }
                });
            });

            // Live password rules.
            var newPw = document.getElementById('settingsNewPassword');
            if (newPw) {
                var rules = {
                    sRuleLength: function (v) { return v.length >= 8; },
                    sRuleUpper: function (v) { return /[A-Z]/.test(v); },
                    sRuleLower: function (v) { return /[a-z]/.test(v); },
                    sRuleNumber: function (v) { return /\d/.test(v); },
                    sRuleSpecial: function (v) { return /[^A-Za-z0-9]/.test(v); }
                };
                newPw.addEventListener('input', function () {
                    var v = this.value;
                    Object.keys(rules).forEach(function (id) {
                        var li = document.getElementById(id);
                        if (!li) return;
                        var icon = li.querySelector('i');
                        if (rules[id](v)) {
                            li.classList.add('valid');
                            icon.classList.remove('fa-circle');
                            icon.classList.add('fa-check-circle');
                        } else {
                            li.classList.remove('valid');
                            icon.classList.remove('fa-check-circle');
                            icon.classList.add('fa-circle');
                        }
                    });
                });
            }
        })();
    </script>
}