@{
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    bool IsActive(string controllerName) =>
        string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - MarketLink Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" />
</head>
<body>
    <div class="ml-app-shell">
        <div class="ml-sidebar-backdrop" id="mlSidebarBackdrop"></div>

        <aside class="ml-sidebar" id="mlSidebar">
            <div class="ml-brand">
                <div class="ml-logo-badge"><i class="fa-solid fa-leaf"></i></div>
                <div class="ml-brand-text">
                    <strong>MarketLink</strong>
                    <small>Admin Panel</small>
                </div>
            </div>

            <nav class="ml-nav">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="ml-nav-link @(IsActive("Dashboard") ? "active" : "")">
                    <i class="fa-solid fa-gauge-high"></i> Dashboard
                </a>

                <div class="ml-nav-section">Market Management</div>
                <a asp-area="Admin" asp-controller="Farmers" asp-action="Index" class="ml-nav-link @(IsActive("Farmers") ? "active" : "")">
                    <i class="fa-solid fa-tractor"></i> Farmers
                </a>
                <a asp-area="Admin" asp-controller="Customers" asp-action="Index" class="ml-nav-link @(IsActive("Customers") ? "active" : "")">
                    <i class="fa-solid fa-users"></i> Customers
                </a>
                <a asp-area="Admin" asp-controller="Markets" asp-action="Index" class="ml-nav-link @(IsActive("Markets") ? "active" : "")">
                    <i class="fa-solid fa-store"></i> Markets
                </a>
                <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="ml-nav-link @(IsActive("Products") ? "active" : "")">
                    <i class="fa-solid fa-carrot"></i> Products
                </a>
                <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="ml-nav-link @(IsActive("Orders") ? "active" : "")">
                    <i class="fa-solid fa-basket-shopping"></i> Orders
                </a>
                <a asp-area="Admin" asp-controller="Reviews" asp-action="Index" class="ml-nav-link @(IsActive("Reviews") ? "active" : "")">
                    <i class="fa-solid fa-star"></i> Reviews
                </a>

                <div class="ml-nav-section">Reports</div>
                <a asp-area="Admin" asp-controller="Reports" asp-action="Index" class="ml-nav-link @(IsActive("Reports") ? "active" : "")">
                    <i class="fa-solid fa-file-lines"></i> Reports
                </a>
                <a asp-area="Admin" asp-controller="Analytics" asp-action="Index" class="ml-nav-link @(IsActive("Analytics") ? "active" : "")">
                    <i class="fa-solid fa-chart-line"></i> Analytics
                </a>

                <div class="ml-nav-section">System</div>
                <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="ml-nav-link @(IsActive("Categories") ? "active" : "")">
                    <i class="fa-solid fa-tags"></i> Categories
                </a>
                <a asp-area="Admin" asp-controller="Announcements" asp-action="Index" class="ml-nav-link @(IsActive("Announcements") ? "active" : "")">
                    <i class="fa-solid fa-bullhorn"></i> Announcements
                </a>
                <a asp-area="Admin" asp-controller="Settings" asp-action="Index" class="ml-nav-link @(IsActive("Settings") ? "active" : "")">
                    <i class="fa-solid fa-gear"></i> Settings
                </a>

                <div class="ml-nav-section">Account</div>
                <a asp-area="Admin" asp-controller="Profile" asp-action="Index" class="ml-nav-link @(IsActive("Profile") ? "active" : "")">
                    <i class="fa-solid fa-user"></i> Profile
                </a>
                <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post" class="px-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="ml-nav-link border-0 bg-transparent w-100 text-start" data-confirm="Log out of MarketLink Admin?">
                        <i class="fa-solid fa-right-from-bracket"></i> Logout
                    </button>
                </form>
            </nav>
        </aside>

        <div class="ml-main">
            <header class="ml-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-sm btn-outline-secondary d-lg-none" id="mlSidebarToggle" type="button">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <div class="ml-search d-none d-md-block">
                        <input type="search" class="form-control form-control-sm" placeholder="Search farmers, orders, products..." />
                    </div>
                </div>
                <div class="ml-user">
                    <i class="fa-regular fa-bell fs-5 text-muted"></i>
                    <div class="ml-avatar">@(User?.Identity?.Name?.Substring(0,1).ToUpper() ?? "A")</div>
                    <div class="d-none d-sm-block">
                        <div class="fw-semibold small">@(User?.Identity?.Name ?? "Admin")</div>
                        <div class="text-muted" style="font-size:11px;">Administrator</div>
                    </div>
                </div>
            </header>

            <main class="ml-content">
                @RenderBody()
            </main>

            <footer class="ml-footer">
                &copy; @DateTime.Now.Year MarketLink &mdash; Farm Fresh Just a Click Away. Admin Panel.
            </footer>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
