@model PagingMeta
@*
    Generic pagination control. Renders page links against the given
    base route, preserving any current query string parameters passed
    in via routeValues (e.g. search term, status filter).
    Usage:
      @await Html.PartialAsync("_Pagination", Model.Result.ToPagingMeta(), new ViewDataDictionary(ViewData) { { "RouteValues", someRouteValueDict } })
*@
@{
    var routeValues = ViewData["RouteValues"] as IDictionary<string, string?> ?? new Dictionary<string, string?>();
}
@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation" class="ml-pagination-wrap">
        <ul class="pagination pagination-sm mb-0">
            @{
                var prevValues = new Dictionary<string, string?>(routeValues) { ["PageNumber"] = (Model.PageNumber - 1).ToString() };
                var nextValues = new Dictionary<string, string?>(routeValues) { ["PageNumber"] = (Model.PageNumber + 1).ToString() };
            }
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" asp-all-route-data="prevValues">Previous</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                var pageValues = new Dictionary<string, string?>(routeValues) { ["PageNumber"] = i.ToString() };
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" asp-all-route-data="pageValues">@i</a>
                </li>
            }
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" asp-all-route-data="nextValues">Next</a>
            </li>
        </ul>
    </nav>
}
