@model AnnouncementEditViewModel
@{
    ViewData["Title"] = $"Edit Announcement - {Model.Title}";
}

<div class="mb-4">
    <a asp-action="Details" asp-route-id="@Model.AnnouncementId" class="small text-muted"><i class="fa-solid fa-arrow-left me-1"></i>Back to Announcement</a>
    <h3 class="mb-0 mt-1">Edit Announcement</h3>
</div>

<div class="ml-card" style="max-width:760px;">
    <form asp-action="Edit" asp-route-id="@Model.AnnouncementId" method="post" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="AnnouncementId" />
        <input type="hidden" asp-for="CreatedAt" />
        <input type="hidden" asp-for="PublishedAt" />
        <input type="hidden" asp-for="CreatedByAdminId" />

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2 small">
                <div asp-validation-summary="ModelOnly"></div>
            </div>
        }

        <div class="mb-3">
            <label asp-for="Title" class="form-label small"></label>
            <input asp-for="Title" class="form-control form-control-sm" />
            <span asp-validation-for="Title" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Message" class="form-label small"></label>
            <textarea asp-for="Message" class="form-control form-control-sm" rows="6"></textarea>
            <span asp-validation-for="Message" class="text-danger small"></span>
        </div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Status" class="form-label small"></label>
                <select asp-for="Status" class="form-select form-select-sm">
                    @foreach (var status in Enum.GetValues(typeof(AnnouncementStatus)).Cast<AnnouncementStatus>())
                    {
                        <option value="@status" selected="@(Model.Status == status)">@status</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="ExpiryAt" class="form-label small"></label>
                <input asp-for="ExpiryAt" type="datetime-local" class="form-control form-control-sm" />
                <span asp-validation-for="ExpiryAt" class="text-danger small"></span>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-ml-primary"><i class="fa-solid fa-floppy-disk me-1"></i>Save Changes</button>
            <a asp-action="Details" asp-route-id="@Model.AnnouncementId" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}