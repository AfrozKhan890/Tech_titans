@model AnnouncementDetailsViewModel
@{
    ViewData["Title"] = $"Announcement - {Model.Announcement.Title}";
    var a = Model.Announcement;
}

<div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
    <div>
        <a asp-action="Index" class="small text-muted"><i class="fa-solid fa-arrow-left me-1"></i>Back to Announcements</a>
        <h3 class="mb-0 mt-1">@a.Title</h3>
        <span class="ml-badge @StatusBadgeHelper.For(a.Status) mt-1 d-inline-block">@a.Status</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@a.AnnouncementId" class="btn btn-ml-primary btn-sm"><i class="fa-regular fa-pen-to-square me-1"></i>Edit</a>
        @if (a.Status != AnnouncementStatus.Published)
        {
            <form asp-action="Publish" asp-route-id="@a.AnnouncementId" method="post" data-confirm="Publish this announcement?">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-ml-accent btn-sm"><i class="fa-solid fa-bullhorn me-1"></i>Publish</button>
            </form>
        }
        else
        {
            <form asp-action="Unpublish" asp-route-id="@a.AnnouncementId" method="post" data-confirm="Unpublish this announcement?">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="fa-solid fa-eye-slash me-1"></i>Unpublish</button>
            </form>
        }
        <form asp-action="Delete" asp-route-id="@a.AnnouncementId" method="post" data-confirm="Delete this announcement permanently?">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger btn-sm"><i class="fa-solid fa-trash me-1"></i>Delete</button>
        </form>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success py-2 small">@TempData["SuccessMessage"]</div>
}

<div class="row g-3">
    <div class="col-lg-8">
        <div class="ml-card mb-3">
            <h6 class="mb-3">Message</h6>
            <p style="white-space:pre-wrap;">@a.Message</p>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="ml-card">
            <h6 class="mb-3">Details</h6>
            <dl class="row mb-0 small">
                <dt class="col-5 text-muted">Status</dt>
                <dd class="col-7"><span class="ml-badge @StatusBadgeHelper.For(a.Status)">@a.Status</span></dd>
                <dt class="col-5 text-muted">Created</dt>
                <dd class="col-7">@a.CreatedAt.ToString("dd MMM yyyy, HH:mm")</dd>
                <dt class="col-5 text-muted">Published</dt>
                <dd class="col-7">@(a.PublishedAt?.ToString("dd MMM yyyy, HH:mm") ?? "-")</dd>
                <dt class="col-5 text-muted">Expires</dt>
                <dd class="col-7">@(a.ExpiryAt?.ToString("dd MMM yyyy, HH:mm") ?? "-")</dd>
                <dt class="col-5 text-muted">Created By</dt>
                <dd class="col-7">@(Model.CreatedBy?.FullName ?? "-")</dd>
            </dl>
        </div>
    </div>
</div>