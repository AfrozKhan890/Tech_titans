@model AnnouncementIndexViewModel
@{
    ViewData["Title"] = "Announcements";
    var routeValues = new Dictionary<string, string?>
    {
        ["SearchTerm"] = Model.Filter.SearchTerm,
        ["Status"] = Model.Filter.Status?.ToString(),
        ["PageSize"] = Model.Filter.PageSize.ToString()
    };
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="mb-0">Announcements</h3>
        <div class="text-muted small">Platform-wide announcements shown to users.</div>
    </div>
    <a asp-action="Create" class="btn btn-ml-primary btn-sm"><i class="fa-solid fa-plus me-1"></i>New Announcement</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success py-2 small">@TempData["SuccessMessage"]</div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="ml-stat-card">
            <div class="ml-stat-icon primary"><i class="fa-solid fa-bullhorn"></i></div>
            <div><div class="ml-stat-value">@Model.TotalAnnouncements</div><div class="ml-stat-label">Total</div></div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="ml-stat-card">
            <div class="ml-stat-icon success"><i class="fa-solid fa-circle-check"></i></div>
            <div><div class="ml-stat-value">@Model.PublishedCount</div><div class="ml-stat-label">Published</div></div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="ml-stat-card">
            <div class="ml-stat-icon accent"><i class="fa-regular fa-pen-to-square"></i></div>
            <div><div class="ml-stat-value">@Model.DraftCount</div><div class="ml-stat-label">Draft</div></div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="ml-stat-card">
            <div class="ml-stat-icon secondary"><i class="fa-solid fa-eye-slash"></i></div>
            <div><div class="ml-stat-value">@Model.UnpublishedCount</div><div class="ml-stat-label">Unpublished</div></div>
        </div>
    </div>
</div>

<div class="ml-card mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-end">
        <div class="col-md-6">
            <label class="form-label small mb-1">Search</label>
            <input type="text" name="SearchTerm" value="@Model.Filter.SearchTerm" class="form-control form-control-sm" placeholder="Title or message..." />
        </div>
        <div class="col-md-3">
            <label class="form-label small mb-1">Status</label>
            <select name="Status" class="form-select form-select-sm">
                <option value="">All statuses</option>
                @foreach (var status in Enum.GetValues(typeof(AnnouncementStatus)).Cast<AnnouncementStatus>())
                {
                    <option value="@status" selected="@(Model.Filter.Status == status)">@status</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-ml-primary btn-sm flex-grow-1"><i class="fa-solid fa-filter me-1"></i>Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
        </div>
    </form>
</div>

<div class="ml-card">
    @if (Model.Result.Items.Any())
    {
        <div class="table-responsive">
            <table class="table ml-table mb-0">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th>Published</th>
                        <th>Expires</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Result.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@a.Title</td>
                            <td><span class="ml-badge @StatusBadgeHelper.For(a.Status)">@a.Status</span></td>
                            <td>@a.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td>@(a.PublishedAt?.ToString("dd MMM yyyy") ?? "-")</td>
                            <td>@(a.ExpiryAt?.ToString("dd MMM yyyy") ?? "-")</td>
                            <td class="text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">Actions</button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" asp-action="Details" asp-route-id="@a.AnnouncementId"><i class="fa-regular fa-eye me-2"></i>View</a></li>
                                        <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@a.AnnouncementId"><i class="fa-regular fa-pen-to-square me-2"></i>Edit</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                        @if (a.Status != AnnouncementStatus.Published)
                                        {
                                            <li>
                                                <form asp-action="Publish" asp-route-id="@a.AnnouncementId" method="post" data-confirm="Publish this announcement?">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                    <button type="submit" class="dropdown-item"><i class="fa-solid fa-bullhorn me-2"></i>Publish</button>
                                                </form>
                                            </li>
                                        }
                                        else
                                        {
                                            <li>
                                                <form asp-action="Unpublish" asp-route-id="@a.AnnouncementId" method="post" data-confirm="Unpublish this announcement?">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                    <button type="submit" class="dropdown-item text-danger"><i class="fa-solid fa-eye-slash me-2"></i>Unpublish</button>
                                                </form>
                                            </li>
                                        }
                                        <li>
                                            <form asp-action="Delete" asp-route-id="@a.AnnouncementId" method="post" data-confirm="Delete this announcement permanently?">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="dropdown-item text-danger"><i class="fa-solid fa-trash me-2"></i>Delete</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
            <span class="text-muted small">
                Showing @((Model.Result.PageNumber - 1) * Model.Result.PageSize + 1)–@(Math.Min(Model.Result.PageNumber * Model.Result.PageSize, Model.Result.TotalCount)) of @Model.Result.TotalCount announcements
            </span>
            @{
                ViewData["RouteValues"] = routeValues;
            }
            @await Html.PartialAsync("_Pagination", Model.Result.ToPagingMeta())
        </div>
    }
    else
    {
        <div class="ml-empty-state">
            <i class="fa-solid fa-bullhorn d-block"></i>
            No announcements found
        </div>
    }
</div>