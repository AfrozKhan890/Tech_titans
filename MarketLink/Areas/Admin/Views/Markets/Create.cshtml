@model MarketCreateViewModel
@{
    ViewData["Title"] = "Add Market";
}

<div class="mb-4">
    <a asp-action="Index" class="small text-muted"><i class="fa-solid fa-arrow-left me-1"></i>Back to Markets</a>
    <h3 class="mb-0 mt-1">Add Market</h3>
</div>

<div class="ml-card" style="max-width:760px;">
    <form asp-action="Create" method="post" novalidate>
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2 small">
                <div asp-validation-summary="ModelOnly"></div>
            </div>
        }

        @await Html.PartialAsync("_MarketFormFields", Model)

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-ml-primary"><i class="fa-solid fa-plus me-1"></i>Create Market</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
