@model MarketDetailsViewModel
@{
    ViewData["Title"] = $"Market - {Model.Market.MarketName}";
    var m = Model.Market;
}

<div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
    <div>
        <a asp-action="Index" class="small text-muted"><i class="fa-solid fa-arrow-left me-1"></i>Back to Markets</a>
        <h3 class="mb-0 mt-1">@m.MarketName</h3>
        <span class="ml-badge @StatusBadgeHelper.For(m.Status) mt-1 d-inline-block">@m.Status</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@m.MarketId" class="btn btn-ml-primary btn-sm"><i class="fa-regular fa-pen-to-square me-1"></i>Edit</a>
        @if (m.Status == MarketStatus.Inactive)
        {
            <form asp-action="Activate" asp-route-id="@m.MarketId" method="post" data-confirm="Activate this market?">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-ml-accent btn-sm"><i class="fa-solid fa-rotate-left me-1"></i>Activate</button>
            </form>
        }
        else
        {
            <form asp-action="Deactivate" asp-route-id="@m.MarketId" method="post" data-confirm="Deactivate this market?">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="fa-solid fa-power-off me-1"></i>Deactivate</button>
            </form>
        }
        <form asp-action="Delete" asp-route-id="@m.MarketId" method="post" data-confirm="Delete this market permanently? Farmers assigned to it will be unassigned, not deleted.">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger btn-sm"><i class="fa-solid fa-trash me-1"></i>Delete</button>
        </form>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success py-2 small">@TempData["SuccessMessage"]</div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-4">
        <div class="ml-stat-card">
            <div class="ml-stat-icon primary"><i class="fa-solid fa-tractor"></i></div>
            <div><div class="ml-stat-value">@Model.TotalFarmers</div><div class="ml-stat-label">Farmers</div></div>
        </div>
    </div>
    <div class="col-6 col-lg-4">
        <div class="ml-stat-card">
            <div class="ml-stat-icon accent"><i class="fa-solid fa-carrot"></i></div>
            <div><div class="ml-stat-value">@Model.TotalProducts</div><div class="ml-stat-label">Products Listed</div></div>
        </div>
    </div>
    <div class="col-6 col-lg-4">
        <div class="ml-stat-card">
            <div class="ml-stat-icon success"><i class="fa-solid fa-calendar-days"></i></div>
            <div><div class="ml-stat-value">@(m.OperatingDays ?? "-")</div><div class="ml-stat-label">Operating Days</div></div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="ml-card mb-3">
            <h6 class="mb-3">Market Information</h6>
            <dl class="row mb-0 small">
                <dt class="col-12 col-sm-5 text-muted">Address</dt><dd class="col-12 col-sm-7">@m.Address</dd>
                <dt class="col-12 col-sm-5 text-muted">Operating Days</dt><dd class="col-12 col-sm-7">@(m.OperatingDays ?? "-")</dd>
                <dt class="col-12 col-sm-5 text-muted">Timings</dt>
                <dd class="col-12 col-sm-7">
                    @if (m.OpeningTime.HasValue && m.ClosingTime.HasValue)
                    {
                        var startText = m.OpeningTime.Value.ToString(@"hh\:mm");
                        var endText = m.ClosingTime.Value.ToString(@"hh\:mm");
                        @(startText + " - " + endText)
                    }
                    else
                    {
                        @:-
                    }
                </dd>
                <dt class="col-12 col-sm-5 text-muted">Latitude</dt><dd class="col-12 col-sm-7">@(m.Latitude?.ToString("N6") ?? "-")</dd>
                <dt class="col-12 col-sm-5 text-muted">Longitude</dt><dd class="col-12 col-sm-7">@(m.Longitude?.ToString("N6") ?? "-")</dd>
                <dt class="col-12 col-sm-5 text-muted">Map Provider</dt><dd class="col-12 col-sm-7">@m.MapProvider</dd>
                <dt class="col-12 col-sm-5 text-muted">Map Link</dt>
                <dd class="col-12 col-sm-7">
                    @if (!string.IsNullOrWhiteSpace(m.MapLink))
                    {
                        <a href="@m.MapLink" target="_blank" rel="noopener">Open map<i class="fa-solid fa-arrow-up-right-from-square ms-1 small"></i></a>
                    }
                    else
                    {
                        @:-
                    }
                </dd>
                <dt class="col-12 col-sm-5 text-muted">Created</dt><dd class="col-12 col-sm-7">@m.CreatedAt.ToString("dd MMM yyyy")</dd>
            </dl>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="ml-card">
            <h6 class="mb-3">Farmers at this Market (@Model.TotalFarmers)</h6>
            @if (Model.Farmers.Any())
            {
                <div class="table-responsive">
                    <table class="table ml-table mb-0">
                        <thead><tr><th>Stall / Business</th><th>Contact</th><th>Operating Days</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var f in Model.Farmers)
                            {
                                <tr>
                                    <td>
                                        <a asp-area="Admin" asp-controller="Farmers" asp-action="Details" asp-route-id="@f.FarmerId">@f.StallName</a>
                                    </td>
                                    <td>@f.ContactPerson</td>
                                    <td>@(f.OperatingDays ?? "-")</td>
                                    <td><span class="ml-badge @StatusBadgeHelper.For(f.Status)">@f.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="ml-empty-state"><i class="fa-solid fa-tractor d-block"></i>No farmers assigned to this market</div>
            }
        </div>
    </div>
</div>
