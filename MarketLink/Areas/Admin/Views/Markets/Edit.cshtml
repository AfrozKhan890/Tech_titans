@model MarketEditViewModel
@{
    ViewData["Title"] = $"Edit Market - {Model.MarketName}";
}

<div class="mb-4">
    <a asp-action="Details" asp-route-id="@Model.MarketId" class="small text-muted"><i class="fa-solid fa-arrow-left me-1"></i>Back to Market</a>
    <h3 class="mb-0 mt-1">Edit Market</h3>
</div>

<div class="ml-card" style="max-width:760px;">
    <form asp-action="Edit" asp-route-id="@Model.MarketId" method="post" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="MarketId" />

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2 small">
                <div asp-validation-summary="ModelOnly"></div>
            </div>
        }

        @await Html.PartialAsync("_MarketFormFields", Model)

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-ml-primary"><i class="fa-solid fa-floppy-disk me-1"></i>Save Changes</button>
            <a asp-action="Details" asp-route-id="@Model.MarketId" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
