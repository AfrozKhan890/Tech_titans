@model CategoryCreateViewModel
@{
    ViewData["Title"] = "Add Category";
}

<div class="mb-4">
    <a asp-action="Index" class="small text-muted"><i class="fa-solid fa-arrow-left me-1"></i>Back to Categories</a>
    <h3 class="mb-0 mt-1">Add Category</h3>
</div>

<div class="ml-card" style="max-width:640px;">
    <form asp-action="Create" method="post" novalidate>
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2 small">
                <div asp-validation-summary="ModelOnly"></div>
            </div>
        }

        <div class="mb-3">
            <label asp-for="Name" class="form-label small"></label>
            <input asp-for="Name" class="form-control form-control-sm" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label small"></label>
            <textarea asp-for="Description" class="form-control form-control-sm" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>
        <div class="form-check form-switch mb-3">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label small"></label>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-ml-primary"><i class="fa-solid fa-plus me-1"></i>Create Category</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}