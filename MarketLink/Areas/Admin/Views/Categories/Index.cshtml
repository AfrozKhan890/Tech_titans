@model CategoryIndexViewModel
@{
    ViewData["Title"] = "Categories";
    var routeValues = new Dictionary<string, string?>
    {
        ["SearchTerm"] = Model.Filter.SearchTerm,
        ["IsActive"] = Model.Filter.IsActive?.ToString(),
        ["PageSize"] = Model.Filter.PageSize.ToString()
    };
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="mb-0">Categories</h3>
        <div class="text-muted small">Product categories used across the platform.</div>
    </div>
    <a asp-action="Create" class="btn btn-ml-primary btn-sm"><i class="fa-solid fa-plus me-1"></i>Add Category</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success py-2 small">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger py-2 small">@TempData["ErrorMessage"]</div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-4">
        <div class="ml-stat-card">
            <div class="ml-stat-icon primary"><i class="fa-solid fa-tags"></i></div>
            <div><div class="ml-stat-value">@Model.TotalCategories</div><div class="ml-stat-label">Total</div></div>
        </div>
    </div>
    <div class="col-6 col-lg-4">
        <div class="ml-stat-card">
            <div class="ml-stat-icon success"><i class="fa-solid fa-circle-check"></i></div>
            <div><div class="ml-stat-value">@Model.ActiveCount</div><div class="ml-stat-label">Active</div></div>
        </div>
    </div>
    <div class="col-6 col-lg-4">
        <div class="ml-stat-card">
            <div class="ml-stat-icon secondary"><i class="fa-solid fa-circle-xmark"></i></div>
            <div><div class="ml-stat-value">@Model.InactiveCount</div><div class="ml-stat-label">Inactive</div></div>
        </div>
    </div>
</div>

<div class="ml-card mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-end">
        <div class="col-md-6">
            <label class="form-label small mb-1">Search</label>
            <input type="text" name="SearchTerm" value="@Model.Filter.SearchTerm" class="form-control form-control-sm" placeholder="Name or description..." />
        </div>
        <div class="col-md-3">
            <label class="form-label small mb-1">Status</label>
            <select name="IsActive" class="form-select form-select-sm">
                <option value="">All</option>
                <option value="true" selected="@(Model.Filter.IsActive == true)">Active only</option>
                <option value="false" selected="@(Model.Filter.IsActive == false)">Inactive only</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-ml-primary btn-sm flex-grow-1"><i class="fa-solid fa-filter me-1"></i>Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Reset</a>
        </div>
    </form>
</div>

<div class="ml-card">
    @if (Model.Result.Items.Any())
    {
        <div class="table-responsive">
            <table class="table ml-table mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Created</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Result.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@c.Name</td>
                            <td class="small text-muted">@(string.IsNullOrWhiteSpace(c.Description) ? "-" : c.Description)</td>
                            <td>@c.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (c.IsActive)
                                {
                                    <span class="ml-badge ml-badge-active">Active</span>
                                }
                                else
                                {
                                    <span class="ml-badge ml-badge-inactive">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">Actions</button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@c.CategoryId"><i class="fa-regular fa-pen-to-square me-2"></i>Edit</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                        @if (c.IsActive)
                                        {
                                            <li>
                                                <form asp-action="Deactivate" asp-route-id="@c.CategoryId" method="post" data-confirm="Deactivate this category?">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                    <button type="submit" class="dropdown-item text-danger"><i class="fa-solid fa-power-off me-2"></i>Deactivate</button>
                                                </form>
                                            </li>
                                        }
                                        else
                                        {
                                            <li>
                                                <form asp-action="Activate" asp-route-id="@c.CategoryId" method="post" data-confirm="Activate this category?">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                    <button type="submit" class="dropdown-item"><i class="fa-solid fa-rotate-left me-2"></i>Activate</button>
                                                </form>
                                            </li>
                                        }
                                        <li>
                                            <form asp-action="Delete" asp-route-id="@c.CategoryId" method="post" data-confirm="Delete this category permanently? Products using it will become uncategorised.">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="dropdown-item text-danger"><i class="fa-solid fa-trash me-2"></i>Delete</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
            <span class="text-muted small">
                Showing @((Model.Result.PageNumber - 1) * Model.Result.PageSize + 1)–@(Math.Min(Model.Result.PageNumber * Model.Result.PageSize, Model.Result.TotalCount)) of @Model.Result.TotalCount categories
            </span>
            @{
                ViewData["RouteValues"] = routeValues;
            }
            @await Html.PartialAsync("_Pagination", Model.Result.ToPagingMeta())
        </div>
    }
    else
    {
        <div class="ml-empty-state">
            <i class="fa-solid fa-tags d-block"></i>
            No categories found
        </div>
    }
</div>