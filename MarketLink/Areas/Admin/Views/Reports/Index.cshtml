@{
    ViewData["Title"] = "Reports & Analytics";
    var marketRevenue = ViewBag.MarketRevenue as IEnumerable<dynamic> ?? Array.Empty<dynamic>();
    var farmerActivity = ViewBag.FarmerActivity as IEnumerable<dynamic> ?? Array.Empty<dynamic>();
    var productStats = ViewBag.ProductStats as IEnumerable<dynamic> ?? Array.Empty<dynamic>();
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div><h4 class="fw-bold mb-1" style="color:var(--heading);">Reports & Analytics</h4><p class="text-muted small mb-0">Revenue is counted only for <strong>Completed</strong> orders. Activity excludes Cancelled orders.</p></div>
    <a asp-action="Analytics" asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To" class="btn btn-outline-success btn-pill"><i class="fas fa-chart-line me-1"></i>Daily Analytics</a>
</div>
<form method="get" class="card p-3 mb-4"><div class="row g-3 align-items-end"><div class="col-12 col-md-4"><label class="form-label">From</label><input type="date" name="from" value="@ViewBag.From" class="form-control" /></div><div class="col-12 col-md-4"><label class="form-label">To</label><input type="date" name="to" value="@ViewBag.To" class="form-control" /></div><div class="col-md-4 d-flex gap-2"><button class="btn btn-primary-green btn-pill">Apply</button><a asp-action="Index" class="btn btn-outline-secondary btn-pill">Clear</a></div></div></form>
<div class="row g-3 mb-4"><div class="col-12 col-md-3"><div class="card p-3"><div class="text-muted small">Orders</div><h3>@ViewBag.TotalOrders</h3></div></div><div class="col-12 col-md-3"><div class="card p-3"><div class="text-muted small">Completed Revenue</div><h3>$@(((decimal)ViewBag.TotalRevenue).ToString("N2"))</h3></div></div><div class="col-12 col-md-3"><div class="card p-3"><div class="text-muted small">Farmers</div><h3>@ViewBag.TotalFarmers</h3></div></div><div class="col-12 col-md-3"><div class="card p-3"><div class="text-muted small">Customers</div><h3>@ViewBag.TotalCustomers</h3></div></div></div>
<div class="row g-4 mb-4">
<div class="col-12 col-lg-6"><div class="card h-100"><div class="card-header fw-bold">Market-level Revenue</div><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Market</th><th>Orders</th><th>Revenue</th></tr></thead><tbody>@foreach(var x in marketRevenue){<tr><td>@x.Name</td><td>@x.Orders</td><td>$@x.Revenue.ToString("N2")</td></tr>}@if(!marketRevenue.Any()){<tr><td colspan="3" class="text-muted">No completed orders in this period.</td></tr>}</tbody></table></div></div></div>
<div class="col-12 col-lg-6"><div class="card h-100"><div class="card-header fw-bold">Most-active Farmers</div><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Farmer</th><th>Orders</th><th>Completed</th><th>Revenue</th></tr></thead><tbody>@foreach(var x in farmerActivity){<tr><td>@x.Name</td><td>@x.Orders</td><td>@x.CompletedOrders</td><td>$@x.Revenue.ToString("N2")</td></tr>}@if(!farmerActivity.Any()){<tr><td colspan="4" class="text-muted">No activity in this period.</td></tr>}</tbody></table></div></div></div>
</div>
<div class="card mb-4"><div class="card-header fw-bold">Product / Order Statistics</div><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Product</th><th>Farmer</th><th>Units</th><th>Orders</th><th>Revenue</th></tr></thead><tbody>@foreach(var x in productStats){<tr><td>@x.Name</td><td>@x.Farmer</td><td>@x.Quantity</td><td>@x.Orders</td><td>$@x.Revenue.ToString("N2")</td></tr>}@if(!productStats.Any()){<tr><td colspan="5" class="text-muted">No completed product sales in this period.</td></tr>}</tbody></table></div></div>
<div class="d-flex flex-wrap gap-2"><a asp-action="ExportOrdersCsv" asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To" class="btn btn-primary-green btn-pill"><i class="fas fa-file-csv me-1"></i>Export Orders CSV</a><a asp-action="ExportFarmersCsv" class="btn btn-outline-success btn-pill"><i class="fas fa-users me-1"></i>Export Farmers CSV</a></div>
