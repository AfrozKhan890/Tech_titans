@{
    ViewData["Title"] = "Contact Us";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <span class="badge px-3 py-2 rounded-pill mb-3" style="background:var(--secondary);color:var(--on-light);font-weight:700;font-size:12px;letter-spacing:1px;text-transform:uppercase;">
            We're here to help
        </span>
        <h1 class="fw-bold" style="font-family:var(--font-heading);color:var(--heading);">Contact MarketLink eGreen Basket</h1>
        <p class="text-muted mx-auto" style="max-width:640px;">Questions about an order, a pickup window, or listing your farm? Use whichever channel fits best.</p>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-12 col-md-4">
            <div class="card h-100 text-center p-4" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
                <div class="mx-auto mb-3" style="width:52px;height:52px;border-radius:14px;background:rgba(92,111,43,0.12);display:flex;align-items:center;justify-content:center;color:var(--primary-text);font-size:20px;">
                    <i class="fas fa-envelope"></i>
                </div>
                <h5 class="fw-bold" style="color:var(--heading);">Email</h5>
                <p class="text-muted small mb-2">Support replies within one working day.</p>
                <a class="fw-semibold" style="color:var(--primary-text);" href="mailto:support@marketlink.com">support@marketlink.com</a>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100 text-center p-4" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
                <div class="mx-auto mb-3" style="width:52px;height:52px;border-radius:14px;background:rgba(92,111,43,0.12);display:flex;align-items:center;justify-content:center;color:var(--primary-text);font-size:20px;">
                    <i class="fas fa-phone-alt"></i>
                </div>
                <h5 class="fw-bold" style="color:var(--heading);">Phone</h5>
                <p class="text-muted small mb-2">Monday to Saturday, 9:00 – 18:00.</p>
                <a class="fw-semibold" style="color:var(--primary-text);" href="tel:+15550102030">+1 (555) 010-2030</a>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100 text-center p-4" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
                <div class="mx-auto mb-3" style="width:52px;height:52px;border-radius:14px;background:rgba(92,111,43,0.12);display:flex;align-items:center;justify-content:center;color:var(--primary-text);font-size:20px;">
                    <i class="fas fa-map-marker-alt"></i>
                </div>
                <h5 class="fw-bold" style="color:var(--heading);">Market Offices</h5>
                <p class="text-muted small mb-2">Visit any partner market during opening hours.</p>
                <a class="fw-semibold" style="color:var(--primary-text);" asp-controller="Markets" asp-action="Index">Find a market near you</a>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-12"><div class="card overflow-hidden" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
            <div class="p-4"><h5 class="fw-bold mb-1" style="color:var(--heading);"><i class="fas fa-map-marked-alt me-2" style="color:var(--primary-text);"></i>MarketLink Map</h5><p class="text-muted small mb-0">Choose an active market for its actual pickup location and directions.</p></div>
            @if (ViewBag.ContactMarket is MarketLink.Models.Market contactMarket)
            {
                var lat = contactMarket.Latitude; var lon = contactMarket.Longitude; var delta = 0.04;
                var bbox = $"{(lon-delta).ToString(System.Globalization.CultureInfo.InvariantCulture)},{(lat-delta).ToString(System.Globalization.CultureInfo.InvariantCulture)},{(lon+delta).ToString(System.Globalization.CultureInfo.InvariantCulture)},{(lat+delta).ToString(System.Globalization.CultureInfo.InvariantCulture)}";
                <div style="height:360px;"><iframe title="OpenStreetMap" width="100%" height="100%" style="border:0;" loading="lazy" src="https://www.openstreetmap.org/export/embed.html?bbox=@bbox&amp;layer=mapnik&amp;marker=@lat,@lon"></iframe></div>
            }
            else
            {
                <div class="p-5 text-center text-muted">No active market location is currently configured.</div>
            }
        </div></div>
    </div>

    <div class="row g-4 align-items-center">
        <div class="col-12 col-lg-6">
            <h4 class="fw-bold mb-3" style="color:var(--heading);">Before you write to us</h4>
            <p class="text-muted">Most questions are answered in seconds if you check here first:</p>
            <ul class="list-unstyled" style="color:var(--body-text);">
                <li class="mb-2"><i class="fas fa-check me-2" style="color:var(--primary-text);"></i>Track or cancel an order from <a asp-area="Customer" asp-controller="Orders" asp-action="Index">My Orders</a>.</li>
                <li class="mb-2"><i class="fas fa-check me-2" style="color:var(--primary-text);"></i>Pickup times are chosen at checkout and shown on the order page.</li>
                <li class="mb-2"><i class="fas fa-check me-2" style="color:var(--primary-text);"></i>Farmers manage stock in the <a asp-area="Farmer" asp-controller="Products" asp-action="Index">Farmer Hub</a>.</li>
                <li><i class="fas fa-check me-2" style="color:var(--primary-text);"></i>Payment is settled directly with the farmer at pickup.</li>
            </ul>
        </div>
        <div class="col-12 col-lg-6">
            <div class="card p-4" style="border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
                <h5 class="fw-bold" style="color:var(--heading);"><i class="fas fa-tractor me-2" style="color:var(--primary-text);"></i>Want to sell your harvest?</h5>
                <p class="text-muted small">Create a seller account, add your produce and pickup slots, then our team approves your stall — usually within one working day.</p>
                <div class="d-flex gap-2 flex-wrap">
                    <a asp-controller="Auth" asp-action="Register" asp-route-role="Farmer" class="btn btn-primary-green btn-pill px-4">Become a Seller</a>
                    <a asp-controller="Farmers" asp-action="Index" class="btn btn-outline-green btn-pill px-4">Browse Farms</a>
                </div>
            </div>
        </div>
    </div>
</div>
