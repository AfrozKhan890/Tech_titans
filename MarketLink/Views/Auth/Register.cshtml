@model MarketLink.Controllers.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div style="background:var(--bg);min-height:80vh;display:flex;align-items:center;padding:40px 0;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="card border-0 shadow-lg" style="border-radius:24px;overflow:hidden;">
                    <div style="background:var(--accent-strong);padding:32px;text-align:center;color:#fff;">
                        <h4 style="font-weight:700;margin:0;color:#fff;">Create Account</h4>
                        <p style="font-size:14px;opacity:0.9;margin:8px 0 0;">
                            @(Model.Role == "Farmer" ? "Start selling your local produce" : "Join our community of conscious shoppers")
                        </p>
                    </div>
                    <div class="card-body p-4 p-md-5">
                        <form asp-action="Register" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size:14px;"></div>

                            <input type="hidden" asp-for="Role" />

                            <div class="d-flex gap-2 mb-4">
                                <a class="btn btn-sm flex-fill @(Model.Role == "Customer" ? "btn-primary-green" : "btn-outline-green")" asp-action="Register" asp-route-role="Customer">
                                    <i class="fas fa-shopping-basket me-1"></i> I am a Buyer
                                </a>
                                <a class="btn btn-sm flex-fill @(Model.Role == "Farmer" ? "btn-accent" : "btn-outline-secondary")" asp-action="Register" asp-route-role="Farmer">
                                    <i class="fas fa-tractor me-1"></i> I am a Seller
                                </a>
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-12 col-sm-6">
                                    <label asp-for="FirstName" class="form-label" style="font-size:13px;font-weight:600;color:var(--heading);">First Name</label>
                                    <input asp-for="FirstName" class="form-control" style="background:var(--bg);border:1px solid var(--border);" placeholder="Jane" />
                                    <span asp-validation-for="FirstName" class="text-danger" style="font-size:12px;"></span>
                                </div>
                                <div class="col-12 col-sm-6">
                                    <label asp-for="LastName" class="form-label" style="font-size:13px;font-weight:600;color:var(--heading);">Last Name</label>
                                    <input asp-for="LastName" class="form-control" style="background:var(--bg);border:1px solid var(--border);" placeholder="Doe" />
                                    <span asp-validation-for="LastName" class="text-danger" style="font-size:12px;"></span>
                                </div>
                            </div>

                            @if (Model.Role == "Farmer")
                            {
                                <div class="mb-4">
                                    <label asp-for="FarmName" class="form-label" style="font-size:13px;font-weight:600;color:var(--heading);">Farm / Business Name</label>
                                    <input asp-for="FarmName" class="form-control" style="background:var(--bg);border:1px solid var(--border);" placeholder="Green Acres Farm" />
                                    <span asp-validation-for="FarmName" class="text-danger" style="font-size:12px;"></span>
                                </div>
                            }

                            <div class="mb-4">
                                <label asp-for="Email" class="form-label" style="font-size:13px;font-weight:600;color:var(--heading);">Email Address</label>
                                <input asp-for="Email" class="form-control form-control-lg" style="font-size:14px;background:var(--bg);border:1px solid var(--border);" placeholder="name@example.com" />
                                <span asp-validation-for="Email" class="text-danger" style="font-size:12px;"></span>
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-12 col-sm-6">
                                    <label asp-for="Phone" class="form-label" style="font-size:13px;font-weight:600;color:var(--heading);">Phone</label>
                                    <input asp-for="Phone" class="form-control" style="background:var(--bg);border:1px solid var(--border);" placeholder="+1 555 000 0000" />
                                    <span asp-validation-for="Phone" class="text-danger" style="font-size:12px;"></span>
                                </div>
                                <div class="col-12 col-sm-6">
                                    <label asp-for="AddressLine1" class="form-label" style="font-size:13px;font-weight:600;color:var(--heading);">Address</label>
                                    <input asp-for="AddressLine1" class="form-control" style="background:var(--bg);border:1px solid var(--border);" placeholder="123 Main Street" />
                                    <span asp-validation-for="AddressLine1" class="text-danger" style="font-size:12px;"></span>
                                </div>
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-12 col-sm-4">
                                    <label asp-for="City" class="form-label" style="font-size:13px;font-weight:600;color:var(--heading);">City</label>
                                    <input asp-for="City" class="form-control" style="background:var(--bg);border:1px solid var(--border);" placeholder="Springfield" />
                                    <span asp-validation-for="City" class="text-danger" style="font-size:12px;"></span>
                                </div>
                                <div class="col-12 col-sm-4">
                                    <label asp-for="State" class="form-label" style="font-size:13px;font-weight:600;color:var(--heading);">State / Province</label>
                                    <input asp-for="State" class="form-control" style="background:var(--bg);border:1px solid var(--border);" placeholder="IL" />
                                    <span asp-validation-for="State" class="text-danger" style="font-size:12px;"></span>
                                </div>
                                <div class="col-12 col-sm-4">
                                    <label asp-for="PostalCode" class="form-label" style="font-size:13px;font-weight:600;color:var(--heading);">Postal Code</label>
                                    <input asp-for="PostalCode" class="form-control" style="background:var(--bg);border:1px solid var(--border);" placeholder="62701" />
                                    <span asp-validation-for="PostalCode" class="text-danger" style="font-size:12px;"></span>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Password" class="form-label" style="font-size:13px;font-weight:600;color:var(--heading);">Password</label>
                                <div class="password-field">
                                    <input asp-for="Password" class="form-control form-control-lg password-input" style="font-size:14px;background:var(--bg);border:1px solid var(--border);padding-right:46px;" placeholder="••••••••" />
                                    <button type="button" class="password-toggle" aria-label="Show password" tabindex="-1"><i class="fas fa-eye"></i></button>
                                </div>
                                <span asp-validation-for="Password" class="text-danger" style="font-size:12px;"></span>
                                <div class="form-text" style="font-size:11px;">At least 8 characters with an uppercase letter and a digit.</div>
                            </div>

                            <div class="mb-4">
                                <label asp-for="ConfirmPassword" class="form-label" style="font-size:13px;font-weight:600;color:var(--heading);">Confirm Password</label>
                                <div class="password-field">
                                    <input asp-for="ConfirmPassword" class="form-control form-control-lg password-input" style="font-size:14px;background:var(--bg);border:1px solid var(--border);padding-right:46px;" placeholder="••••••••" />
                                    <button type="button" class="password-toggle" aria-label="Show password" tabindex="-1"><i class="fas fa-eye"></i></button>
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:12px;"></span>
                            </div>

                            <button type="submit" class="btn btn-accent btn-lg btn-pill w-100 shadow">Sign Up</button>
                        </form>

                        <div class="text-center mt-4">
                            <p style="font-size:14px;color:var(--body-text);margin:0;">
                                Already have an account? <a asp-action="Login" style="color:var(--primary-text);font-weight:600;text-decoration:none;">Log in</a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
